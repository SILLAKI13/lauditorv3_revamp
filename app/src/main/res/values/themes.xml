<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MyApplication" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Primary brand color. -->
        <item name="colorPrimary">@color/Blue_text_color</item>
        <item name="colorPrimaryVariant">@color/Blue_text_color</item>
        <item name="colorOnPrimary">@color/white</item>
        <!-- Secondary brand color. -->
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/scheduled_text</item>
        <item name="colorOnSecondary">@color/black</item>
        <!-- Status bar color. -->
        <item name="android:statusBarColor">@color/Blue_text_color</item>
        <!-- Customize your theme here. -->
    </style>
    <style name="Theme.MyApplication.NoActionBar" parent="Theme.MyApplication">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
    </style>

    <style name="MyAlertDialog" parent="Theme.AppCompat.Dialog">
        <item name="android:windowBackground">@color/dialog_bg</item>
        <item name="android:layout_gravity">center</item>
    </style>
    <style name="TabLayoutGreenOverlay" parent="">
        <item name="colorPrimary">@color/scheduled_text</item>
        <item name="colorSecondary">@color/scheduled_text</item>
    </style>

</resources>