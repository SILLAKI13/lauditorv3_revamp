<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/four_dp"
    android:layout_marginEnd="@dimen/four_dp"
    android:background="@drawable/rectangle_light_grey"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/et_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_weight="1"
        android:background="@drawable/background_transparent"
        android:ellipsize="end"
        android:fontFamily="@font/gill_sans"
        android:gravity="start|center_vertical"
        android:padding="@dimen/ten_dp"
        android:textColor="@color/black"
        android:textColorHint="@color/grey_color_dark"
        android:textSize="@dimen/Fifteen_dp" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/six_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <!-- MINUS button -->
        <TextView
            android:id="@+id/tv_minus"
            android:layout_width="@dimen/thirty_five_dp"
            android:layout_height="@dimen/thirty_dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/one_dp"
            android:background="@drawable/rectangle_grey_bg"
            android:gravity="center"
            android:text="−"
            android:textColor="@color/black"
            android:textSize="@dimen/twenty_dp"
            android:visibility="visible" />

        <!-- PLUS button -->
        <TextView
            android:id="@+id/tv_plus"
            android:layout_width="@dimen/thirty_five_dp"
            android:layout_height="@dimen/thirty_dp"
            android:layout_gravity="center_vertical"
            android:background="@drawable/rectangle_grey_bg"
            android:gravity="center"
            android:text="+"
            android:textColor="@color/black"
            android:textSize="@dimen/twenty_dp"
            android:visibility="visible" />

    </LinearLayout>
</LinearLayout>