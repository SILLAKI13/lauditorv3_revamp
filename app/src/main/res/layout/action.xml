<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/one_sixty"
    android:layout_height="@dimen/thirty_five_dp"
    android:layout_margin="@dimen/ten_dp"
    android:layout_weight="1"
    app:cardBackgroundColor="@color/blue"
    app:cardCornerRadius="@dimen/eight_dp"
    app:cardElevation="@dimen/four_dp">

    <LinearLayout
        android:id="@+id/action_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five_dp"
        android:orientation="horizontal"
        android:padding="@dimen/four_dp">

        <TextView
            android:id="@+id/textView2"
            android:layout_width="@dimen/two_hundred"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/gill_sans"
            android:gravity="center"
            android:padding="@dimen/two_dp"
            android:text="Action"
            android:textColor="@color/white"
            android:textSize="@dimen/Fifteen_dp" />

        <LinearLayout
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_gravity="end">

            <Spinner
                android:id="@+id/sp_action"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:backgroundTint="@color/white"
                android:clickable="false"
                android:drawableRight="@drawable/spinner_action"
                android:focusable="true" />
        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>