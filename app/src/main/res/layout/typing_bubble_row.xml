<?xml version="1.0" encoding="utf-8"?>
<!--
    typing_bubble_row.xml — save under res/layout/.
    Received-style bubble with three dots, matching the reference image
    (left-aligned, rounded grey bubble). Shown as the last row in the chat
    RecyclerView while the other person is composing, via
    MessageListAdapter.setTypingBubbleVisible(true).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="start"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/ten_dp"
    android:paddingEnd="@dimen/ten_dp"
    android:paddingTop="12dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/typing_bubble_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@drawable/rectangular_grey_background"
        android:paddingStart="@dimen/Fifteen_dp"
        android:paddingEnd="@dimen/Fifteen_dp"
        android:paddingTop="14dp"
        android:paddingBottom="10dp">

        <View
            android:id="@+id/dot1"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/blue_circular" />

        <View
            android:id="@+id/dot2"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/blue_circular" />

        <View
            android:id="@+id/dot3"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/blue_circular" />

    </LinearLayout>
</LinearLayout>