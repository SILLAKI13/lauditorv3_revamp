<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
android:backgroundTint="@color/white"
    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/two_dp"
        android:layout_marginEnd="@dimen/two_dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/tv_title_education"
            layout="@layout/black_normal_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/tv_add_education"
            layout="@layout/small_count_green_txt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thirty_dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_education"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/two_dp"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/two_dp">

        <include
            android:id="@+id/tv_title_certification"
            layout="@layout/black_normal_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/tv_add_certification"
            layout="@layout/small_count_green_txt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thirty_dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_certification"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:orientation="vertical" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/two_dp"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/two_dp">

        <include
            android:id="@+id/tv_title_awards"
            layout="@layout/black_normal_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <include
            android:id="@+id/tv_add_awards"
            layout="@layout/small_count_green_txt"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thirty_dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_awards"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:orientation="vertical" />

</LinearLayout>