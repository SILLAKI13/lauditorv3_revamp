<?xml version="1.0" encoding="utf-8"?>
<!--
    deleted_doc_view.xml
    Matches view_documents_list.xml design exactly:
      - Top row  : blue document icon | bold file name (2 lines) | 3-dot icon
      - Info card: rounded light-grey bg with Description / Date / Deleted By / Deleted On / Document Type
      - Floating dropdown: Restore | Delete  (same CardView + ListView pattern as normal view)
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/five_dp"
    android:paddingEnd="@dimen/five_dp"
    android:paddingBottom="@dimen/ten_dp">

    <!-- ═══════════════════════════════════════════════════════════════════
         MAIN CARD  (white, rounded, subtle shadow)
         ═══════════════════════════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_view_documents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- ── TOP ROW : icon  |  name block  |  3-dot ─────────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Blue doc icon (same as view_documents_list) -->
                <ImageView
                    android:id="@+id/iv_doc_image"
                    android:layout_width="@dimen/forty_dp"
                    android:layout_height="@dimen/forty_dp"
                    android:src="@drawable/doc_pale_blue"
                    android:scaleType="fitCenter" />

                <!-- File / document name (bold, up to 2 lines) -->
                <TextView
                    android:id="@+id/tv_client_name"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginEnd="6dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:fontFamily="@font/gill_sans_bold"
                    android:textSize="@dimen/Fifteen_dp"
                    android:textColor="@color/black"
                    android:lineSpacingExtra="2dp" />

                <!-- 3-dot vertical menu icon (same as view_documents_list) -->
                <ImageView
                    android:id="@+id/custom_spinner_cardview"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:padding="4dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/img_17" />

            </LinearLayout>

            <!-- ── INFO BAND : light grey rounded box ───────────────────── -->
            <LinearLayout
                android:id="@+id/ll_view_icons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:background="@drawable/rectangle_light_grey"
                android:orientation="vertical"
                android:padding="@dimen/ten_dp">

                <!-- Description row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description: "
                        android:fontFamily="@font/gill_sans_regular"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_doc_description"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:fontFamily="@font/gill_sans"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                </LinearLayout>

                <!-- Date row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Date :"
                        android:fontFamily="@font/gill_sans_regular"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_created_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gill_sans"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                </LinearLayout>

                <!-- Deleted By row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_deleted_by"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/deleted_by"
                        android:fontFamily="@font/gill_sans_regular"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_deleted_by_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gill_sans"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                </LinearLayout>

                <!-- Deleted On row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_deleted_on"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/deleted_on"
                        android:fontFamily="@font/gill_sans_regular"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_deleted_on_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gill_sans"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                </LinearLayout>

                <!-- Document Type row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_doc_type"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/document_type"
                        android:fontFamily="@font/gill_sans_regular"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                    <TextView
                        android:id="@+id/tv_doc_type_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gill_sans"
                        android:textSize="@dimen/Twelve_dp"
                        android:textColor="@color/black" />

                </LinearLayout>

            </LinearLayout>

            <!-- Hidden RelativeLayout for adapter compatibility -->
            <RelativeLayout
                android:id="@+id/rl_deletedView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <!--
                Hidden zero-size stub icons so MyViewHolder.findViewById()
                for restore_icon / delete_icon never returns null.
                Real actions are driven by the 3-dot dropdown above.
            -->
            <ImageView
                android:id="@+id/restore_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/delete_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <!-- ═══════════════════════════════════════════════════════════════════
         FLOATING ACTION DROPDOWN  (Restore | Delete)
         Anchored top-end below the 3-dot icon — identical to normal view
         ═══════════════════════════════════════════════════════════════════ -->
    <androidx.cardview.widget.CardView
        android:id="@+id/action_list_card"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/Fifty_dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:elevation="50dp"
        android:translationZ="50dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/ten_dp"
        app:cardElevation="@dimen/Fifteen_dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cv_view_documents">

        <include
            layout="@layout/action_layout_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>