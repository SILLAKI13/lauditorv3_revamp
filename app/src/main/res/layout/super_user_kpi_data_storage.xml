<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Card_Layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten_dp"
    android:background="@drawable/rectangular_white_background"
    android:elevation="@dimen/four_dp"
    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/Card_Image"
            android:layout_width="@dimen/forty_dp"
            android:layout_height="@dimen/forty_dp"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/ten_dp"
            android:src="@drawable/used_storage_limit" />

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="@dimen/four_dp"
            android:layout_weight="1"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include
                android:id="@+id/tv_total"
                layout="@layout/blue_bold_txt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/two_dp"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tv_total_data_storage"
                    layout="@layout/count_green_normal_txt" />

                <include
                    android:id="@+id/tv_tot_gb"
                    layout="@layout/black_normal_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/four_dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/tv_ds_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/four_dp"
            android:layout_marginEnd="@dimen/four_dp"
            android:layout_weight="1"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include
                android:id="@+id/tv_total"
                layout="@layout/blue_bold_txt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/two_dp"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tv_total_data_storage"
                    layout="@layout/count_green_normal_txt" />

                <include
                    android:id="@+id/tv_tot_gb"
                    layout="@layout/black_normal_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/four_dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
            android:id="@+id/tv_bs_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/four_dp"
            android:layout_marginEnd="@dimen/four_dp"
            android:layout_weight="1"
            android:baselineAligned="true"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <include
                android:id="@+id/tv_total"
                layout="@layout/blue_bold_txt"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/two_dp"
                android:baselineAligned="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tv_total_data_storage"
                    layout="@layout/count_green_normal_txt" />

                <include
                    android:id="@+id/tv_tot_gb"
                    layout="@layout/black_normal_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="bottom"
                    android:layout_marginTop="@dimen/four_dp" />
            </LinearLayout>
        </LinearLayout>
    </androidx.appcompat.widget.LinearLayoutCompat>
</LinearLayout>