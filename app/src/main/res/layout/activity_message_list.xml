<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rectangular_white_background"
    android:elevation="@dimen/six_dp"
    android:orientation="vertical">

    <!-- HEADER — fixed, never moves -->
    <LinearLayout
        android:id="@+id/ll_header"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/four_dp">

        <!-- Chat Title -->
        <include
            android:id="@+id/tv_chat"
            layout="@layout/black_normal_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten_dp"
            android:layout_marginTop="@dimen/ten_dp" />

        <!-- HEADER CARDVIEW -->

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:id="@+id/headerLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/four_dp"
                android:background="@drawable/rectangle_light_grey"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ten_dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/back_button"
                    android:layout_width="@dimen/thirty_dp"
                    android:layout_height="@dimen/thirty_dp"
                    android:src="@drawable/back_arrow_black" />

                <!--
                    FrameLayout wrapper added around person_icon so the
                    presence dot can overlap its bottom-right corner -
                    headerLayout is a horizontal LinearLayout, whose
                    children can't overlap directly.
                -->
                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <include
                        android:id="@+id/person_icon"
                        layout="@layout/tv_count_circle"
                        android:layout_width="@dimen/forty_dp"
                        android:layout_height="@dimen/forty_dp"
                        android:layout_marginStart="@dimen/ten_dp" />

                    <!--
                        Presence dot: red (offline) by default, switched to
                        green via code (PresenceManager.isOnline) once
                        presence state for this contact is known. Hidden
                        (gone) until then.
                    -->
                    <View
                        android:id="@+id/header_presence_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:layout_gravity="bottom|end"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/red_circular"
                        android:visibility="gone" />

                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/eight_dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <include
                        android:id="@+id/tv_contactName"
                        layout="@layout/black_normal_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <!--
                        Online/Offline text label, shown below the contact
                        name. Updated alongside header_presence_dot from
                        MessagesList.java based on PresenceManager.isOnline().
                        Hidden until presence state for this contact is known.
                    -->
                    <TextView
                        android:id="@+id/tv_presence_status"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gill_sans"
                        android:text="Offline"
                        android:textColor="@color/material_dynamic_neutral50"
                        android:textSize="12sp"
                        android:visibility="gone" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/iv_search"
                    android:layout_width="@dimen/thirty_dp"
                    android:layout_height="@dimen/thirty_dp"
                    android:src="@drawable/green_search"
                    app:tint="@color/blue"/>

                <ImageView
                    android:id="@+id/iv_video_call"
                    android:layout_width="@dimen/forty_dp"
                    android:layout_height="@dimen/forty_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/four_dp"
                    android:src="@drawable/video_btn" />

            </LinearLayout>

            <include
                android:id="@+id/search_layout"
                layout="@layout/search_chat"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/four_dp"
                android:visibility="gone"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/headerLayout" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </LinearLayout>

    <!-- RecyclerView — takes all remaining space, compresses when keyboard opens -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/chat_background"
        android:orientation="vertical">
        <include
            android:id="@+id/reyclerview_message_list"
            layout="@layout/recyclerview"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="@dimen/ten_dp"
            android:layout_weight="1" />

        <!-- Chat Input Box — stays pinned above keyboard -->
        <androidx.cardview.widget.CardView
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:backgroundTint="@color/white"
            android:layout_height="wrap_content"
            android:elevation="@dimen/four_dp"
            app:cardCornerRadius="@dimen/ten_dp">

            <LinearLayout
                android:id="@+id/layout_chatbox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/ten_dp">

                <EditText
                    android:id="@+id/edittext_chatbox"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/forty_dp"
                    android:layout_weight="1"
                    android:background="@drawable/circular_white_bg"
                    android:hint="Type a message"
                    android:maxLines="1"
                    android:paddingStart="@dimen/ten_dp"
                    android:fontFamily="@font/gill_sans"
                    android:paddingEnd="@dimen/Fifteen_dp"
                    android:textColor="@color/black"
                    android:textColorHint="@color/grey_text" />

                <ImageView
                    android:id="@+id/button_chatbox_send"
                    android:layout_width="@dimen/Fifty_dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/two_dp"
                    android:clickable="true"
                    android:contentDescription="Send"
                    android:focusable="true"
                    android:padding="@dimen/four_dp"
                    android:src="@drawable/send_btn" />

            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>
</LinearLayout>