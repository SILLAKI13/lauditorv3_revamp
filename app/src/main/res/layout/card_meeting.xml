<?xml version="1.0" encoding="utf-8"?>
<!--  card_meeting.xml  -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten_dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Header row ─────────────────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_calendar_blue"
                android:background="@drawable/icon_bg_blue"
                android:padding="9dp"
                android:scaleType="fitCenter"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Meetings"
                    android:textSize="@dimen/Fifteen_dp"
                    android:textStyle="bold"
                    android:textColor="@color/black"/>

            </LinearLayout>

            <!-- Badge ──────────────────────────────────────────────────── -->
            <TextView
                android:id="@+id/tv_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="28dp"
                android:padding="6dp"
                android:gravity="center"
                android:text="0"
                android:textSize="@dimen/Twelve_dp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/pale_blue_circular"/>

        </LinearLayout>

        <!-- ── Meeting detail (shown when hasMeeting=true) ───────────── -->
        <LinearLayout
            android:id="@+id/ll_meeting_detail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tv_subject"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/Fifteen_dp"
                android:textStyle="bold"
                android:textColor="@color/black"
                android:maxLines="2"
                android:ellipsize="end"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="@dimen/Fifteen_dp"
                    android:layout_height="@dimen/Fifteen_dp"
                    android:src="@drawable/ic_time_blue"
                    android:tint="@color/blue"/>

                <TextView
                    android:id="@+id/tv_time_range"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="5dp"
                    android:textSize="@dimen/Twelve_dp"
                    android:textColor="#5A5A7A"/>

                <View
                    android:layout_width="1dp"
                    android:layout_height="12dp"
                    android:layout_marginHorizontal="8dp"
                    android:background="#CCCCDD"/>

                <TextView
                    android:id="@+id/tv_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/Twelve_dp"
                    android:textColor="#5A5A7A"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ── No meeting state ───────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_no_meeting"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No meetings scheduled for today"
            android:textSize="@dimen/Twelve_dp"
            android:textColor="@color/grey_text"
            android:visibility="visible"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>
