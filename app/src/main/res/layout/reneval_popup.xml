<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ten_dp"
    android:layout_marginTop="@dimen/ten_dp"
    android:layout_marginEnd="@dimen/ten_dp"
    android:layout_marginBottom="@dimen/ten_dp"
    android:padding="@dimen/four_dp"
    android:background="@drawable/rectangular_white_background"
    android:elevation="@dimen/four_dp"
    android:orientation="vertical">

    <!-- Matter title -->

    <!-- Remove icon (OVERLAPPED) -->
    <include
        android:id="@+id/iv_close"
        android:layout_width="@dimen/thirty_dp"
        android:layout_height="@dimen/thirty_dp"
        android:layout_gravity="end"
        layout="@layout/simple_cancel_icon"/>

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:id="@+id/ll_Confirm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/white"
        android:elevation="@dimen/four_dp"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/ten_dp">

        <include
            android:id="@+id/tv_confirmation"
            layout="@layout/blue_bold_large_txt" />

        <include
            android:id="@+id/tv_confirmContent"
            layout="@layout/black_normal_txt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten_dp" />


        <include
            android:id="@+id/btnSave"
            layout="@layout/submit_dark_layout" />
    </LinearLayout>
</LinearLayout>