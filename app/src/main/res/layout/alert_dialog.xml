<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/four_dp"
    android:paddingStart="@dimen/forty_dp"
    android:paddingEnd="@dimen/forty_dp">

    <LinearLayout
        android:id="@+id/ll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/aler_dialog_bg"
        android:orientation="vertical"
        android:paddingTop="@dimen/Fifteen_dp">

        <TextView
            android:id="@+id/alert_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/Fifteen_dp"
            android:layout_marginEnd="@dimen/Fifteen_dp"
            android:layout_marginBottom="@dimen/five_dp"
            android:fontFamily="@font/gill_sans_bold"
            android:gravity="center"
            android:text="@string/alert"
            android:textColor="@color/black"
            android:textFontWeight="500"
            android:textSize="@dimen/seventeen_dp" />

        <include
            android:id="@+id/alert_content"
            layout="@layout/black_normal_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/Fifteen_dp"
            android:layout_marginEnd="@dimen/Fifteen_dp"
            android:layout_marginBottom="@dimen/ten_dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="0.1dp"
            android:layout_marginTop="@dimen/ten_dp"
            android:background="@color/grey_medium" />

        <include
            android:id="@+id/tv_ok"
            layout="@layout/borderless_btn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</LinearLayout>
