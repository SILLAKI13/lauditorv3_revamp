<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"

    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_pale"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- CardView Container -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/twenty_dp"
        android:layout_marginBottom="@dimen/twenty_dp"
        android:padding="@dimen/twenty_dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/thirty_dp"
        app:cardElevation="@dimen/twenty_dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/thirty_dp"
            android:gravity="center"
            android:orientation="vertical">

            <include
                android:id="@+id/imageView"
                layout="@layout/logo_layout" />

            <!-- Success Message -->
            <TextView
                android:id="@+id/tv_otp_sent_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans"
                android:text="OTP sent to your email"
                android:textColor="@color/Red"
                android:textSize="@dimen/Fifteen_dp "
                android:textStyle="bold"
                android:visibility="gone" />

            <!-- Title -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty_dp"
                android:fontFamily="@font/gill_sans"
                android:text="Verify OTP"
                android:textColor="@color/black"
                android:textSize="@dimen/twenty_dp"
                android:textStyle="bold" />

            <!-- Subtitle - Moved to start alignment -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/four_dp"
                android:layout_marginTop="@dimen/twenty_dp"
                android:layout_marginBottom="@dimen/ten_dp"
                android:fontFamily="@font/gill_sans"
                android:gravity="start"
                android:text="Enter 6-digit OTP"
                android:textColor="@color/black"
                android:textSize="@dimen/Fifteen_dp" />

            <!-- OTP Input Boxes - Now adaptive -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="6">

                <EditText
                    android:id="@+id/otpBox1"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_margin="@dimen/four_dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_bg"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:longClickable="true"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/twenty_dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/otpBox2"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_margin="@dimen/four_dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_bg"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:longClickable="true"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/twenty_dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/otpBox3"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_margin="@dimen/four_dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_bg"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:longClickable="true"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/twenty_dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/otpBox4"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_margin="@dimen/four_dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_bg"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:longClickable="true"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/twenty_dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/otpBox5"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_margin="@dimen/four_dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_bg"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:longClickable="true"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/twenty_dp"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/otpBox6"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_margin="@dimen/four_dp"
                    android:layout_weight="1"
                    android:background="@drawable/otp_box_bg"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:importantForAutofill="no"
                    android:inputType="number"
                    android:longClickable="true"
                    android:textColor="@color/black"
                    android:textIsSelectable="true"
                    android:textSize="@dimen/twenty_dp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Resend OTP Timer -->
            <TextView
                android:id="@+id/tvResendOtp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginEnd="@dimen/ten_dp"
                android:clickable="true"
                android:focusable="true"
                android:fontFamily="@font/gill_sans"
                android:text="@string/resend_otp"
                android:textColor="@color/Primary_new"
                android:textSize="@dimen/Fifteen_dp"
                android:textStyle="bold"
                android:visibility="visible" />

            <!-- Buttons -->

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/ll_save_buttons"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_margin="@dimen/ten_dp"
                android:orientation="horizontal"
                android:visibility="visible">

                <include
                    android:id="@+id/btnCancel"
                    layout="@layout/cancel_button" />

                <include
                    android:id="@+id/btnVerifyOtp"
                    layout="@layout/submit_button" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <!-- Register Link -->
            <LinearLayout
                android:id="@+id/ll_register"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty_dp"
                android:visibility="gone"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/don_t_have_an_account"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_register_here"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/two_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/register_here"
                    android:textColor="@color/Primary_new"
                    android:textSize="@dimen/Fifteen_dp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>