<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/custom_spinner_cardview"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_dp"
        android:layout_margin="@dimen/ten_dp"
        android:elevation="@dimen/four_dp"
        android:layout_weight="1"
        app:cardBackgroundColor="@color/Primary"
        app:cardCornerRadius="@dimen/eight_dp"
        app:cardElevation="@dimen/ten_dp">

        <TextView
            android:id="@+id/custom_spinner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five_dp"
            android:layout_gravity="center"
            android:layout_weight="1"
            android:drawableRight="@drawable/arrows"
            android:fontFamily="@font/gill_sans"
            android:gravity="center"
            android:paddingStart="@dimen/four_dp"
            android:paddingEnd="@dimen/four_dp"
            android:text="Action"
            android:textColor="@color/white"
            android:textSize="@dimen/twenty_dp" />
    </androidx.cardview.widget.CardView>
</RelativeLayout>
