<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangular_white_background"
    android:orientation="vertical">

    <include layout="@layout/header_layout" />

    <LinearLayout
        android:id="@+id/ll_tag_type"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ten_dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/tv_document_name"
                layout="@layout/title_name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <include layout="@layout/astrick_layout" />

        </LinearLayout>

        <include
            android:id="@+id/response_email"
            layout="@layout/response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/four_dp"
            android:visibility="gone" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tv_edit_doc_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/zero_dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_weight="1"
            android:gravity="top"
            android:layoutDirection="rtl"
            android:textColorHint="@color/black"
            android:textDirection="ltr"
            app:boxBackgroundMode="outline"
            app:counterEnabled="true"
            app:counterMaxLength="50"
            app:counterTextColor="@color/grey_color_dark">


            <include
                android:id="@+id/edit_doc_name"
                layout="@layout/title_description_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/zero_dp"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginEnd="@dimen/ten_dp"
                android:layout_weight="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/response_docname"
            layout="@layout/response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/four_dp"
            android:visibility="gone" />

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/description"
                layout="@layout/title_name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <include layout="@layout/astrick_layout" />

        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tv_edit_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="top"
            android:layout_marginStart="@dimen/zero_dp"
            android:layout_marginEnd="@dimen/_10dp"
            android:layout_weight="1"
            android:gravity="top"
            android:layoutDirection="rtl"
            android:textDirection="ltr"
            app:boxBackgroundMode="outline"
            app:counterEnabled="true"
            app:counterMaxLength="300"
            app:counterTextColor="@color/grey_color_dark">

            <include
                android:id="@+id/edit_description"
                layout="@layout/description_large_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one_fifty_dp"
                android:layout_marginStart="@dimen/zero_dp"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginEnd="@dimen/ten_dp" />

        </com.google.android.material.textfield.TextInputLayout>

        <include
            android:id="@+id/response_docdes"
            layout="@layout/response"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/four_dp"
            android:visibility="gone" />

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:orientation="horizontal">

            <include
                android:id="@+id/expiration_date_id"
                layout="@layout/title_name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <include
            android:id="@+id/tv_expiration_date"
            layout="@layout/button_calender" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_tag"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_tag"
        app:layout_constraintVertical_bias="0.0">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        </LinearLayout>

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_buttons"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/ten_dp"
            android:orientation="horizontal"
            android:padding="@dimen/ten_dp">

            <include
                android:id="@+id/btn_cancel_edit_docs"
                layout="@layout/cancel_button" />

            <include
                android:id="@+id/btn_save_tag"
                layout="@layout/submit_button" />

        </androidx.appcompat.widget.LinearLayoutCompat>
    </LinearLayout>
</LinearLayout>