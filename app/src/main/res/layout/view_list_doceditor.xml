<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ten_dp"
    android:layout_marginTop="@dimen/ten_dp"
    android:layout_marginEnd="@dimen/ten_dp">

    <androidx.cardview.widget.CardView
        android:id="@+id/action_cv"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/forty_dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/eight_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.043">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="@dimen/ten_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/tv_description"
                    layout="@layout/black_small_bold_txt"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />


                <LinearLayout
                    android:id="@+id/ll_owner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tv_created_by"
                        layout="@layout/black_normal_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/tv_created_by_name"
                        layout="@layout/black_normal_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/created_date"
                        layout="@layout/black_normal_txt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/tv_created_date"
                        layout="@layout/black_normal_txt"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/action_custom_layout"
                layout="@layout/custom_layout_file"
                android:layout_width="@dimen/one_thiry_dp"
                android:layout_height="wrap_content" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <include
        android:id="@+id/sp_action"
        layout="@layout/action_layout_list"
        android:layout_width="@dimen/action_list_width"
        android:layout_height="@dimen/action_list_height_gp"
        android:layout_below="@+id/action_cv"
        android:layout_alignParentEnd="true"
        android:visibility="gone"
        android:background="@color/design_default_color_on_primary"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/action_cv" />
</androidx.constraintlayout.widget.ConstraintLayout>