<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"

    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <TextView
        android:id="@+id/tv_booking_settings"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ten_dp"
        android:fontFamily="@font/gill_sans_bold"
        android:text="@string/booking_settings"
        android:visibility="gone"
        android:textColor="@color/Blue_text_color"
        android:textSize="@dimen/Fifteen_dp" />
    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:visibility="gone"
        android:background="@drawable/info_box_bg"
        android:padding="@dimen/ten_dp">



        <TextView
            android:id="@+id/tvInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gill_sans"
            android:text="@string/availability_info_txt"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/Fifteen_dp"
            android:textStyle="normal" />
    </RelativeLayout>

    <!-- Slot Duration + Minimum Booking Hours Row -->
    <LinearLayout
        android:id="@+id/slot_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ten_dp"
        android:orientation="horizontal">

        <!-- Slot Duration Component -->
        <LinearLayout
            android:layout_width="@dimen/two_hundred"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ten_dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans"
                android:text="Slot Duration"
                android:textColor="@color/grey_medium"
                android:textSize="@dimen/Fifteen_dp" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_slot_duration"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_dp"
                android:layout_marginTop="@dimen/ten_dp"
                android:background="@drawable/rectangular_button_green_count"
                android:editable="false"
                android:fontFamily="@font/gill_sans"
                android:text="30 minutes"
                android:textAllCaps="false"
                android:textColor="@android:color/white" />
        </LinearLayout>

        <!-- Minimum Booking Hours Component -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/min_hours"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="Minimum Booking Hours"
                    android:textColor="@color/grey_medium"
                    android:textSize="@dimen/Fifteen_dp" />

                <ImageView
                    android:id="@+id/iv_info"
                    android:layout_width="@dimen/twenty_dp"
                    android:layout_height="@dimen/twenty_dp"
                    android:layout_marginStart="@dimen/four_dp"
                    android:src="@drawable/iv_info"
                    app:tint="@color/dark_grey_new" />


            </LinearLayout>


            <TextView
                android:id="@+id/tv_min_booking_hours"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/forty_dp"
                android:layout_marginTop="@dimen/ten_dp"
                android:background="@drawable/rectangle_light_grey"
                android:editable="false"
                android:fontFamily="@font/gill_sans"
                android:padding="@dimen/ten_dp"
                android:text="4 hours"
                android:textColor="@color/black" />
        </LinearLayout>

    </LinearLayout>

    <!-- Weekly Hours Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/twenty_dp"
            android:layout_height="@dimen/twenty_dp"
            android:src="@drawable/timer" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/four_dp"
            android:layout_weight="1"
            android:fontFamily="@font/gill_sans"
            android:gravity="center_vertical"
            android:text="Weekly hours"
            android:textColor="@color/pale_blue"
            android:textSize="@dimen/Fifteen_dp" />

        <ImageView
            android:id="@+id/iv_info1"
            android:layout_width="@dimen/twenty_dp"
            android:layout_height="@dimen/twenty_dp"
            android:layout_marginEnd="@dimen/ten_dp"
            android:layout_marginStart="@dimen/ten_dp"
            android:src="@drawable/iv_info"
            app:tint="@color/dark_blue" />

    </LinearLayout>

    <!-- Description -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/Fifteen_dp"
        android:fontFamily="@font/gill_sans"
        android:text="Set when you are typically available for meetings"
        android:textColor="@color/grey_medium"
        android:textSize="@dimen/Fifteen_dp" />

    <!-- Weekly Hours List -->
    <LinearLayout
        android:id="@+id/ll_weekly_hours"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Repeat for each day -->

    </LinearLayout>

    <RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:background="@drawable/info_box_bg"
        android:padding="@dimen/ten_dp"
        android:visibility="gone">

        <ImageView
            android:id="@+id/iv_info2"
            android:layout_width="@dimen/twenty_dp"
            android:layout_height="@dimen/twenty_dp"
            android:layout_marginEnd="@dimen/ten_dp"
            android:src="@drawable/iv_info"
            app:tint="@color/dark_blue" />

        <TextView
            android:id="@+id/tvInfo3"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toRightOf="@+id/iv_info2"
            android:fontFamily="@font/gill_sans"
            android:text="@string/availability_info_txt"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/Fifteen_dp"
            android:textStyle="normal" />
    </RelativeLayout>


</LinearLayout>

