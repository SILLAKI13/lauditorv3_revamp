<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/four_dp"
    android:layout_marginTop="@dimen/four_dp"
    android:layout_marginEnd="@dimen/four_dp"
    android:layout_marginBottom="@dimen/ten_dp"
    android:background="@drawable/new_rect_grey"
    android:elevation="@dimen/four_dp"
    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <!-- TOP ROW -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/tv_day"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gill_sans"
            android:text="Monday"
            android:textColor="@color/black"
            android:textSize="@dimen/Fifteen_dp" />

        <TextView
            android:id="@+id/tv_work_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten_dp"
            android:layout_weight="1"
            android:fontFamily="@font/gill_sans"
            android:gravity="end"
            android:text="09:00 AM - 07:00 PM"
            android:textColor="@color/grey_light"
            android:textSize="@dimen/Fifteen_dp" />

    </LinearLayout>

    <TextView
        android:id="@+id/tv_available_time"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/four_dp"
        android:background="@drawable/completed_badge"
        android:fontFamily="@font/gill_sans"
        android:gravity="end"
        android:paddingHorizontal="@dimen/ten_dp"
        android:paddingVertical="@dimen/four_dp"
        android:text="10.0 hours available"
        android:textColor="@color/completed_text"
        android:textSize="@dimen/Twelve_dp" />

    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_dp"
        android:layout_marginTop="@dimen/five_dp"
        android:background="@color/grey"
        android:padding="@dimen/ten_dp" />

    <!-- BLOCKED ROW -->
    <LinearLayout
        android:id="@+id/ll_blocked_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/Fifteen_dp"
            android:layout_height="@dimen/Fifteen_dp"
            android:src="@drawable/block"
            app:tint="@color/Red" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/six_dp"
            android:fontFamily="@font/gill_sans"
            android:text="@string/excluded"
            android:textColor="@color/Red"
            android:textSize="@dimen/Fifteen_dp" />

        <GridLayout
            android:id="@+id/ll_blockedtime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="2"
            android:layout_marginStart="@dimen/four_dp"
            android:useDefaultMargins="true" />


    </LinearLayout>

</LinearLayout>
