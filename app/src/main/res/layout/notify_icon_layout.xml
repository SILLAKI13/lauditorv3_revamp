<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/notify_container"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/four_dp"
    android:orientation="vertical">

    <!-- Badge -->
    <TextView
        android:id="@+id/notify_badge"
        android:layout_width="@dimen/thirty_dp"
        android:layout_height="@dimen/thirty_dp"
        android:layout_gravity="end|top"
        android:layout_marginStart="@dimen/Fifteen_dp"
        android:layout_marginEnd="@dimen/four_dp"
        android:autoSizeMaxTextSize="@dimen/ten_dp"
        android:autoSizeMinTextSize="@dimen/one_dp"
        android:autoSizeTextType="uniform"
        android:maxLines="1"
        android:background="@drawable/red_count_circular"
        android:fontFamily="@font/gill_sans_bold"
        android:gravity="center"
        android:padding="@dimen/four_dp"
        android:paddingStart="@dimen/four_dp"
        android:paddingEnd="@dimen/four_dp"
        android:text="0"
        android:textColor="@android:color/white"
        android:textSize="@dimen/ten_dp"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/notify_icon"
        android:layout_width="@dimen/thirty_dp"
        android:layout_height="@dimen/thirty_dp"
        android:layout_marginTop="@dimen/Twelve_dp"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_marginEnd="@dimen/six_dp"
        android:background="@drawable/bell_icon"
        android:contentDescription="Notification Icon"
        android:padding="@dimen/eight_dp"
        android:scaleType="centerInside" />

</FrameLayout>
