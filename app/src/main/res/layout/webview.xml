<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <!-- Top RelativeLayout with TextView and ImageButtons -->

    <!-- WebView below ll_view -->


    <RelativeLayout
        android:id="@+id/ll_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/blue"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ten_dp">

        <TextView
            android:id="@+id/tv_contactName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ten_dp"
            android:layout_marginStart="@dimen/thirty_five_dp"
            android:layout_marginTop="@dimen/five_dp"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:paddingStart="@dimen/ten_dp"
            android:text="@string/name"

            android:textColor="@android:color/white" />

        <ImageButton
            android:id="@+id/btn_back"
            android:layout_width="@dimen/thirty_dp"
            android:layout_height="@dimen/thirty_dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/left_arr"
            android:background="@color/blue"
            tools:ignore="TouchTargetSizeCheck" />



    </RelativeLayout>

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/ll_view" />

</RelativeLayout>
