<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <LinearLayout
        android:id="@+id/main_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten_dp"
        android:background="@drawable/rectangular_white_background"
        android:elevation="@dimen/four_dp"
        android:orientation="vertical"
        android:padding="@dimen/ten_dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Name row with action (3-dot) icon -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <include
                android:id="@+id/tv_name"
                layout="@layout/blue_bold_txt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <ImageView
                android:id="@+id/iv_action_menu"
                android:layout_width="@dimen/thirty_dp"
                android:layout_height="@dimen/thirty_dp"
                android:padding="4dp"
                android:src="@drawable/img_17"
                android:scaleType="fitCenter"
                android:contentDescription="Actions" />

        </LinearLayout>

        <!-- Designation row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tv_designation"
                    layout="@layout/owner_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/four_dp" />

                <include
                    android:id="@+id/tv_designation_name"
                    layout="@layout/owner_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

        <!-- Specialist row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/tv_specialist"
                layout="@layout/owner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/four_dp" />

            <include
                android:id="@+id/tv_specialist_name"
                layout="@layout/owner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/email"
                layout="@layout/owner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/four_dp" />

            <include
                android:id="@+id/tv_email"
                layout="@layout/owner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/phone"
                layout="@layout/owner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/four_dp" />

            <include
                android:id="@+id/tv_phonenumber"
                layout="@layout/owner_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <!-- Email + Phone row -->




    </LinearLayout>

    <!-- FLOATING ACTION DROPDOWN MENU -->
    <androidx.cardview.widget.CardView
        android:id="@+id/action_list_card"
        android:layout_width="160dp"
        android:layout_height="wrap_content"
        android:layout_marginEnd="12dp"
        android:layout_marginTop="56dp"
        android:elevation="50dp"
        android:translationZ="50dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/ten_dp"
        app:cardElevation="@dimen/Fifteen_dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="@+id/main_container"
        app:layout_constraintTop_toTopOf="@+id/main_container">

        <ListView
            android:id="@+id/action_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@color/light_grey"
            android:dividerHeight="0.5dp"
            android:scrollbars="none" />

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>