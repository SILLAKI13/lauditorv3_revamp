<?xml version="1.0" encoding="utf-8"?>
<!--
    event_details_notifications.xml
    Used for BOTH attendee rows AND document rows.
    Attendee rows: fl_avatar visible, iv_rsvp visible, iv_event_docView gone
    Document rows: fl_avatar gone,   iv_rsvp gone,    iv_event_docView visible
    NO background on this layout — document rows get background applied in Java.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="6dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="6dp"
    android:paddingEnd="4dp"
    android:paddingBottom="6dp">

    <!-- Avatar circle (attendee rows only) -->
    <FrameLayout
        android:id="@+id/fl_avatar"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="10dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/tv_avatar_initials"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/avatar_circle_background"
            android:fontFamily="@font/gill_sans"
            android:gravity="center"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="bold" />

    </FrameLayout>

    <!-- Name / text label -->
    <TextView
        android:id="@+id/tv_event_notifications"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:fontFamily="@font/gill_sans"
        android:textColor="@color/black"
        android:textSize="14sp" />

    <!-- Eye icon — document rows only -->
    <ImageView
        android:id="@+id/iv_event_docView"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="6dp"
        android:contentDescription="View document"
        android:padding="2dp"
        android:src="@drawable/eye_open"
        android:visibility="gone"
        app:tint="@color/light_blue" />

    <!-- RSVP status icon — attendee rows only -->
    <ImageView
        android:id="@+id/iv_rsvp"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="6dp"
        android:contentDescription="RSVP status"
        android:src="@drawable/icon_cancel"
        android:visibility="gone" />

</LinearLayout>