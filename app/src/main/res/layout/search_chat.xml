<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangle_light_grey">

    <!-- Search Input -->
    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_search_chat"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/background_transparent"
        android:fontFamily="@font/gill_sans"
        android:gravity="center_vertical"
        android:hint="@string/type_to_search"
        android:importantForAutofill="no"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:padding="@dimen/ten_dp"
        android:textColor="@color/black"
        android:textColorHint="@color/grey_color_dark"
        android:textSize="@dimen/Fifteen_dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/iv_search_cancel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Cancel Button -->
    <ImageView
        android:id="@+id/iv_search_cancel"
        android:layout_width="@dimen/forty_dp"
        android:layout_height="@dimen/forty_dp"
        android:contentDescription="@string/cancel"
        android:padding="@dimen/six_dp"
        android:src="@drawable/search_groups"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
