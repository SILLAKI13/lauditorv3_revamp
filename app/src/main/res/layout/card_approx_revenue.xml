<?xml version="1.0" encoding="utf-8"?>
<!--  card_approx_revenue.xml  –  Approximate Revenue (Business Metrics) -->
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Card_Layout"
    android:layout_width="@dimen/ThreeHundred_dp"
    android:layout_height="@dimen/one_sixty"
    android:layout_margin="@dimen/six_dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/eighteen_sp"
    app:cardElevation="@dimen/two_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/Fifteen_dp">

        <!-- ── Row 1 : icon + % chip ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <FrameLayout
                android:layout_width="@dimen/forty_dp"
                android:layout_height="@dimen/forty_dp">

                <ImageView
                    android:layout_width="@dimen/forty_dp"
                    android:layout_height="@dimen/forty_dp"
                    android:src="@drawable/icon_bg_green"/>

                <ImageView
                    android:layout_width="@dimen/twenty_dp"
                    android:layout_height="@dimen/twenty_dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_revenue"
                    android:scaleType="fitCenter"/>
            </FrameLayout>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tv_revenue_percentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingHorizontal="@dimen/ten_dp"
                android:paddingVertical="4dp"
                android:text="+0.00%"
                android:textSize="@dimen/Twelve_dp"
              android:fontFamily="@font/gill_sans_bold"
                android:textColor="@color/chart_green"
                android:background="@drawable/completed_badge"/>
        </LinearLayout>

        <!-- ── Row 2 : label ──────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/Fifteen_dp"
            android:text="Approximate Revenue"
            android:textSize="@dimen/Twelve_dp"
            android:fontFamily="@font/gill_sans"
            android:textColor="@color/grey_color_dark"/>

        <!-- ── Row 3 : big amount ─────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_revenue_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="₹0.00"
            android:textSize="28sp"
           android:fontFamily="@font/gill_sans_bold"
            android:textColor="@color/black"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="16sp"
            android:autoSizeMaxTextSize="28sp"/>

        <!-- ── Row 4 : date range ─────────────────────────────────────── -->
        <TextView
            android:id="@+id/tv_revenue_date_range"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/gill_sans"
            android:text="Jan 2026 - Feb 2026"
            android:textSize="11sp"
            android:textColor="@color/grey_color_dark"/>

    </LinearLayout>
</androidx.cardview.widget.CardView>