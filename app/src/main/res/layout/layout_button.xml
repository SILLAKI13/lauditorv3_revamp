<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layout_button"
    android:layout_width="match_parent"
    android:layout_height="70dp"
    android:layout_gravity="center_horizontal"
    android:background="@android:color/transparent"
    android:gravity="center_horizontal"
    android:orientation="horizontal"
    android:padding="@dimen/ten_dp">


    <!--Card view for buttons-->
    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_marginTop="@dimen/four_dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/four_dp"
        android:background="@drawable/background_transparent"
      app:cardCornerRadius="@dimen/eight_dp"
        app:cardElevation="@dimen/four_dp">

        <!--Cancel button-->

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/Cancel"
            android:layout_width="@dimen/module_btn_size"
            android:layout_height="@dimen/forty_dp"
            android:layout_gravity="center_horizontal"
            android:background="@color/dark_grey"
            android:elevation="@dimen/four_dp"
            android:fontFamily="@font/gill_sans"
            android:text="Cancel"
            android:textAllCaps="false"
            android:textColor="@color/black"
            android:textFontWeight="600"
            android:textSize="@dimen/Fifteen_dp"
            tools:ignore="TouchTargetSizeCheck" />
    </androidx.cardview.widget.CardView>

    <!--Cardview for submit button-->

        <!--Submit button-->
        <include
            android:id="@+id/Submit"
            layout="@layout/submit_button"
            android:layout_width="@dimen/module_btn_size"
            android:layout_height="@dimen/forty_dp"
            android:layout_gravity="center"
            android:layout_margin="@dimen/ten_dp" />
</LinearLayout>