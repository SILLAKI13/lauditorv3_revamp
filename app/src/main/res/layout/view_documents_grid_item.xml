<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    android:paddingStart="@dimen/five_dp"
    android:paddingEnd="@dimen/five_dp"
    android:paddingBottom="@dimen/ten_dp">

    <!-- MAIN CARD — height is now FIXED and never changes -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_view_documents"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="12dp"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- THUMBNAIL AREA -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:clipChildren="true">

                <View
                    android:id="@+id/view_thumb_placeholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/thirty_dp"
                    android:background="@color/light_grey"
                    android:visibility="visible" />

                <ImageView
                    android:id="@+id/wv_doc_preview"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/thirty_dp"
                    android:background="@android:color/white"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />

                <WebView
                    android:id="@+id/wv_doc_preview_web"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="@dimen/thirty_dp"
                    android:overScrollMode="never"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="6dp"
                    android:paddingEnd="6dp">

                    <ImageView
                        android:id="@+id/lock_open"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/unlock"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/lock_close"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/close"
                        android:visibility="gone" />

                    <View
                        android:layout_width="1dp"
                        android:layout_height="16dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@color/light_grey" />

                    <ImageView
                        android:id="@+id/iv_deleteEnabled"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/down_enabled"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/iv_deleteDisabled"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:padding="2dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/down"
                        android:visibility="gone" />

                </LinearLayout>

                <ProgressBar
                    android:id="@+id/pb_doc_loading"
                    style="?android:attr/progressBarStyle"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_gravity="center"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/colorPrimary"
                    android:visibility="visible" />

            </FrameLayout>

            <!-- BOTTOM INFO BAND -->
            <LinearLayout
                android:id="@+id/ll_view_icons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rectangle_light_grey"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="8dp"
                android:paddingEnd="12dp"
                android:paddingBottom="8dp">

                <TextView
                    android:id="@+id/tv_document_display_name"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/Fifty_dp"
                    android:layout_marginBottom="4dp"
                    android:ellipsize="end"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center_vertical"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Thirteen_dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/tv_created_date"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gill_sans_regular"
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                    <!--
                        Three-dot button — acts as the ANCHOR for the floating PopupWindow.
                        It does NOT expand anything inside this layout, so item height
                        never changes and StaggeredGridLayoutManager has nothing to ghost.
                    -->
                    <LinearLayout
                        android:id="@+id/action_list_card_grid_btn"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="top|end"
                        android:layout_margin="4dp"
                        android:gravity="center">

                        <ImageView
                            android:id="@+id/custom_spinner_cardview"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:padding="6dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/img_17" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/ll_added_tags"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:orientation="horizontal"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tv_tags"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gill_sans_regular"
                        android:text="Tags: "
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_added_tags"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/gill_sans"
                        android:textColor="@color/black"
                        android:textSize="11sp" />

                </LinearLayout>

            </LinearLayout>

            <!-- HIDDEN STUB FIELDS (referenced by adapter for data binding) -->
            <ImageView
                android:id="@+id/iv_doc_image"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_client_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_client_name_one"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_image_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_doc_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_Expiration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tv_Expiration_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/download_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/uv_delete_document"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/iv_edit_document"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <ImageView
                android:id="@+id/tag_icon"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/action_list_card"
        android:layout_width="180dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/_20dp"
        android:visibility="visible"
        android:layout_gravity="end"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/ten_dp"
        app:cardElevation="@dimen/four_dp"
        app:cardUseCompatPadding="false"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@+id/cv_view_documents">

        <include
            layout="@layout/action_layout_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

    </androidx.cardview.widget.CardView>


</LinearLayout>