<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cl_meeting"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_timesheet_type"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <include
            android:id="@+id/tv_create_event"
            layout="@layout/left_title_layout" />

        <include
            android:id="@+id/tv_view_calendar"
            layout="@layout/right_title_layout" />

    </androidx.appcompat.widget.LinearLayoutCompat>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <androidx.appcompat.widget.LinearLayoutCompat
            android:id="@+id/ll_view_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/Twelve_dp"
            android:layout_marginTop="@dimen/twenty_dp"
            android:layout_marginEnd="@dimen/ten_dp"
            android:layout_weight="1"
            android:gravity="start"
            android:orientation="horizontal">

            <include
                android:id="@+id/tv_day_view"
                layout="@layout/left_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/one_dp" />

            <include
                android:id="@+id/tv_month_view"
                layout="@layout/right_title_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </androidx.appcompat.widget.LinearLayoutCompat>

        <LinearLayout
            android:id="@+id/ll_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginStart="@dimen/ten_dp"
            android:layout_marginTop="@dimen/five_dp"
            android:layout_marginEnd="@dimen/ten_dp"
            android:layout_marginBottom="@dimen/five_dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical"
            android:textStyle="bold">

            <include
                android:id="@+id/tv_switchView"
                layout="@layout/common_title_icon" />

            <include
                android:id="@+id/tv_switchCreate"
                layout="@layout/common_title_icon" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_event_type"
        android:layout_width="@dimen/two_hundred"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/Fifteen_dp"
        android:layout_marginBottom="@dimen/five_dp"
        android:orientation="vertical">

        <include
            android:id="@+id/ll_event_Filter"
            layout="@layout/switch_dropdown_view"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forty_dp"
            android:layout_gravity="end"
            android:layout_margin="@dimen/two_dp" />

        <include
            android:id="@+id/sp_event_Filter"
            layout="@layout/white_spinner_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:visibility="gone" />

    </LinearLayout>

    <ScrollView
        android:id="@+id/sv_fragment"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scrollbarStyle="insideInset"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ll_view_type"
        app:layout_constraintVertical_bias="0.016">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <FrameLayout
                android:id="@+id/child_container_timesheets"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingBottom="250dp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>