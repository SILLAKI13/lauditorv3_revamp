<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_details_activity_log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/Fifteen_dp"
        android:elevation="@dimen/forty_dp"
        android:padding="@dimen/ten_dp"
        android:visibility="visible"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/eight_dp">

        <LinearLayout
            android:id="@+id/projectLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten_dp"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/llprojectLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/four_dp"
                    android:layout_marginBottom="@dimen/ten_dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/project_id"
                        layout="@layout/title_name_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <include
                    android:id="@+id/tv_sp_project"
                    layout="@layout/dropdown_spinner_layout" />

                <include
                    android:id="@+id/sp_ags_project"
                    layout="@layout/spinner_list"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one_fifty_dp"
                    android:layout_marginStart="@dimen/four_dp"
                    android:layout_marginEnd="@dimen/four_dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/team_member_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/four_dp"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginBottom="@dimen/ten_dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/team_member_id"
                    layout="@layout/title_name_layout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ten_dp" />

                <include
                    android:id="@+id/tv_sp_team_member"
                    layout="@layout/dropdown_spinner_layout" />

                <include
                    android:id="@+id/sp_ags_tm"
                    layout="@layout/spinner_list"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one_fifty_dp"
                    android:layout_marginStart="@dimen/four_dp"
                    android:layout_marginEnd="@dimen/four_dp" />
            </LinearLayout>
            <!--this is the actual edit text which takes the input-->
            <include
                android:id="@+id/tl_search_matter"
                layout="@layout/search_layout_new"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/four_dp"
                android:layout_marginTop="@dimen/twenty_dp"
                android:layout_marginEnd="@dimen/four_dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- down the cardview-->
    <LinearLayout
        android:id="@+id/linear_down"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/cv_details_activity_log"
        android:layout_marginStart="@dimen/Fifteen_dp"
        android:layout_marginEnd="@dimen/Fifteen_dp"
        android:layout_marginBottom="@dimen/Fifteen_dp"
        android:background="@drawable/round_shadow"
        android:elevation="@dimen/four_dp"
        android:orientation="vertical"
        android:padding="@dimen/ten_dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/two_dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/non_billable_id"
                    layout="@layout/black_bold_txt" />

                <include
                    android:id="@+id/tv_non_billable_hours"
                    layout="@layout/count_green_bold_txt" />

                <include
                    android:id="@+id/hours_id1"
                    layout="@layout/count_green_bold_txt" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <include
                    android:id="@+id/billable_id"
                    layout="@layout/black_bold_txt" />

                <include
                    android:id="@+id/tv_billable_hours"
                    layout="@layout/count_green_bold_txt" />

                <include
                    android:id="@+id/hours_id2"
                    layout="@layout/count_green_bold_txt" />
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/point_five"
            android:layout_marginTop="@dimen/ten_dp"
            android:layout_marginBottom="@dimen/ten_dp"
            android:background="@color/black" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_marginStart="@dimen/two_dp"
            android:layout_weight="1"
            android:baselineAligned="false"
            android:gravity="start"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_weight="1">

                <include
                    android:id="@+id/total_hours_id"
                    layout="@layout/black_bold_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5">

                <include
                    android:id="@+id/tv_total_project_hours"
                    layout="@layout/count_green_bold_txt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <!--close the layout-->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_projects"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/linear_down"
        android:layout_marginStart="@dimen/ten_dp"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:background="@drawable/background_transparent"
        android:orientation="vertical"
        android:padding="@dimen/four_dp" />

</RelativeLayout>
