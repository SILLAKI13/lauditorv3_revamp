<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangular_white_background"
    android:elevation="@dimen/eight_dp"
    android:orientation="vertical">

    <LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/ll_view_document"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rectangular_button_green_count"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="@dimen/two_dp">

        <include
            android:id="@+id/tv_share_documents"
            layout="@layout/header_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_unshare_doc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/tv_unshare_doc"
            layout="@layout/blue_bold_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten_dp"
            android:layout_marginEnd="@dimen/ten_dp" />

        <include
            android:id="@+id/rv_unshare_documents"
            layout="@layout/recyclerview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_fifty_dp"
            android:layout_marginStart="@dimen/four_dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_share_doc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/tv_share_doc"
            layout="@layout/blue_bold_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten_dp"
            android:layout_marginEnd="@dimen/ten_dp" />

        <include
            android:id="@+id/rv_share_documents"
            layout="@layout/recyclerview"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_fifty_dp"
            android:layout_marginStart="@dimen/four_dp" />
    </LinearLayout>

    <include
        android:id="@+id/rv_remove_documents"
        layout="@layout/recyclerview" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/et_share_message"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_fifty_dp"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/ten_dp"
        android:layout_marginTop="@dimen/four_dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:background="@drawable/rectangle_light_grey"
        android:fontFamily="@font/gill_sans"
        android:gravity="start"
        android:hint="@string/type_your_message_optional"
        android:padding="@dimen/ten_dp"
        android:textColor="@color/black"
        android:textColorHint="@color/grey_text"
        android:textSize="@dimen/Fifteen_dp"
        android:visibility="visible" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ten_dp">

        <include
            android:id="@+id/btn_cancel_share"
            layout="@layout/cancel_button" />

        <include
            android:id="@+id/btn_ok_share"
            layout="@layout/submit_button" />
    </LinearLayout>

</LinearLayout>