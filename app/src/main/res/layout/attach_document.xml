<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:orientation="vertical">

    <!-- Top content scrollable -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fillViewport="true"
        android:overScrollMode="never">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <TextView
                android:id="@+id/matter_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/Fifteen_dp"
                android:background="@color/white"
                android:enabled="false"
                android:fontFamily="@font/gill_sans"
                android:gravity="start|center_vertical"
                android:padding="@dimen/four_dp"
                android:text="@string/new_message"
                android:textAllCaps="false"
                android:textColor="@color/Blue_text_color"
                android:textSize="@dimen/twenty_dp" />

            <androidx.appcompat.widget.LinearLayoutCompat
                android:id="@+id/client_type"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:paddingTop="@dimen/twenty_dp">

                <include
                    android:id="@+id/compose_client_name"
                    layout="@layout/left_title_layout" />

                <include
                    android:id="@+id/compose_firm_name"
                    layout="@layout/right_title_layout" />
            </androidx.appcompat.widget.LinearLayoutCompat>

            <include layout="@layout/radio_group_layout" />

            <LinearLayout
                android:id="@+id/ll_client_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    tools:ignore="MissingConstraints">

                    <include
                        android:id="@+id/client_name"
                        layout="@layout/title_name_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten_dp"
                        android:layout_marginEnd="@dimen/ten_dp"
                        android:layout_marginBottom="@dimen/ten_dp" />
                    <!-- android:text="Client Name" -->

                    <include
                        layout="@layout/astrick_layout"
                        android:layout_width="@dimen/Fifteen_dp"
                        android:layout_height="@dimen/ten_dp"
                        android:layout_marginRight="@dimen/four_dp" />
                </LinearLayout>

                <include
                    android:id="@+id/custom_client"
                    layout="@layout/dropdown_spinner_layout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginEnd="@dimen/ten_dp" />

                <include
                    android:id="@+id/client_list_view"
                    layout="@layout/spinner_list"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one_fifty_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginEnd="@dimen/ten_dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_upload_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/six_dp"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tv_select_upload_group_name"
                        layout="@layout/title_name_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/four_dp"
                        android:layout_marginBottom="@dimen/ten_dp" />

                    <include layout="@layout/astrick_layout" />

                </LinearLayout>


                <include
                    android:id="@+id/tv_select_upload_groups"
                    layout="@layout/spinner_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/four_dp"
                    android:layout_marginEnd="@dimen/four_dp" />

                <LinearLayout
                    android:id="@+id/ll_upload_client_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <include
                        android:id="@+id/rv_upload_groups"
                        layout="@layout/recyclerview"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/one_fifty_dp"
                        android:layout_marginStart="@dimen/four_dp"
                        android:layout_marginEnd="@dimen/four_dp" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_matter_view"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/six_dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/ten_dp">

                    <include
                        android:id="@+id/matter_name"
                        layout="@layout/title_name_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />

                    <include layout="@layout/astrick_layout" />
                </LinearLayout>

                <include
                    android:id="@+id/ll_matter"
                    layout="@layout/dropdown_spinner_layout" />

                <include
                    android:id="@+id/list_matter"
                    layout="@layout/spinner_list"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one_fifty_dp"
                    android:layout_marginStart="@dimen/four_dp"
                    android:layout_marginEnd="@dimen/four_dp"
                    android:visibility="gone" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_select_groups"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:orientation="vertical"
                android:visibility="visible">

                <LinearLayout
                    android:id="@+id/ll_attach_grp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginEnd="@dimen/ten_dp"
                    android:orientation="horizontal"
                    android:visibility="visible">

                    <include
                        android:id="@+id/grp_name"
                        layout="@layout/title_name_layout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                    <!--                            android:text="Client Name"-->

                    <include
                        layout="@layout/astrick_layout"
                        android:layout_width="@dimen/Fifteen_dp"
                        android:layout_height="@dimen/ten_dp" />

                </LinearLayout>

                <!-- TextView for selecting groups -->
                <include
                    android:id="@+id/tv_select_groups"
                    layout="@layout/spinner_text_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginTop="@dimen/ten_dp"
                    android:layout_marginEnd="@dimen/ten_dp"
                    android:layout_marginBottom="@dimen/ten_dp"
                    android:visibility="visible" />

                <!-- RecyclerView for displaying groups -->
                <include
                    android:id="@+id/rv_display_upload_groups_docs"
                    layout="@layout/recyclerview"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one_fifty_dp"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_marginEnd="@dimen/ten_dp"
                    android:visibility="gone" />
                <!--                </LinearLayout>-->

                <LinearLayout
                    android:id="@+id/linearLayout2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"

                    android:visibility="visible"
                    app:layout_constraintTop_toBottomOf="@+id/ll_select_groups">

                    <include
                        android:id="@+id/btn_group_cancel"
                        layout="@layout/cancel_button" />

                    <include
                        android:id="@+id/btn_group_submit"
                        layout="@layout/submit_button" />
                </LinearLayout>
            </LinearLayout>


            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_Search_email_document"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ten_dp"
                android:background="@drawable/rectangle_light_grey"
                android:drawableEnd="@drawable/search_groups"
                android:hint="@string/search"
                android:imeOptions="actionDone"
                android:inputType="textFilter"
                android:padding="@dimen/ten_dp"
                tools:ignore="SpeakableTextPresentCheck" />

        </LinearLayout>
    </ScrollView>

    <!-- RecyclerView fills remaining space -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_documents_email"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/ten_dp"
        android:layout_weight="1"
        android:scrollbars="vertical" />

    <!-- Buttons fixed at bottom -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_buttons_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ten_dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/btn_cancel_save"
            layout="@layout/cancel_button" />

        <include
            android:id="@+id/btn_create"
            layout="@layout/submit_button" />
    </androidx.appcompat.widget.LinearLayoutCompat>

</LinearLayout>
