<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center_vertical"
    android:layout_margin="@dimen/four_dp"
    android:background="@color/white"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/document_layout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:padding="@dimen/eight_dp">

        <include
            android:id="@+id/tv_doc_name"
            layout="@layout/blue_bold_txt" />

        <LinearLayout
            android:id="@+id/ll_confidential"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="gone">

            <include
                android:id="@+id/confidential_txt"
                layout="@layout/black_small_bold_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/tv_matter_details_name"
                layout="@layout/black_normal_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

        </LinearLayout>

        <include
            android:id="@+id/tv_doc_date"
            layout="@layout/orange_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/two_dp" />

        <include
            android:id="@+id/tv_file_name"
            layout="@layout/black_bold_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/two_dp" />

    </LinearLayout>

    <include layout="@layout/divider_line" />
</LinearLayout>
