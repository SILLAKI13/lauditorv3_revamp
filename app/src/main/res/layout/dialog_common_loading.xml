<?xml version="1.0" encoding="utf-8"?>
<!--
    dialog_common_loading.xml
    Replicates the Compose CommonLoadingDialog:
      - Card with rounded corners + shadow
      - Rotating logo (iv_loading_logo)
      - Message text below (tv_loading_message)
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:minWidth="200dp">

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:cardCornerRadius="20dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/white"
        app:cardUseCompatPadding="false">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@color/white"
            android:paddingStart="32dp"
            android:paddingEnd="32dp"
            android:paddingTop="24dp"
            android:paddingBottom="24dp"
            android:minWidth="160dp">

            <!--
                Rotating logo — RotateAnimation applied in code.
                Replace @drawable/logo with your actual logo drawable.
            -->
            <ImageView
                android:id="@+id/iv_loading_logo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/logo"
                android:scaleType="fitCenter"
                android:contentDescription="Loading" />

            <!-- Spacer: 14dp — matches Compose Spacer(modifier = Modifier.height(14.dp)) -->
            <View
                android:layout_width="match_parent"
                android:layout_height="14dp" />

            <!-- Message text — matches Compose Text(fontSize=14.sp, color=Gray) -->
            <TextView
                android:id="@+id/tv_loading_message"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Loading..."
                android:textSize="14sp"
                android:textColor="#808080"
                android:gravity="center"
                android:maxLines="2"
                android:ellipsize="end" />

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</LinearLayout>