<?xml version="1.0" encoding="utf-8"?><!--
  card_storage_ds.xml  –  Data Storage card
  Fixed size: 300dp × 350dp  |  Layout matches screenshot
  ┌─────────────────────────────────────────┐
  │  Data Storage                           │
  │  Total Storage          Used            │
  │  15 GB                  2.69 GB (red)   │
  │  ┌──────────┐  Available               │
  │  │  donut   │  12.3 GB (green)          │
  │  └──────────┘  18% used                 │
  └─────────────────────────────────────────┘
-->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/Card_Layout"
    android:layout_width="@dimen/ThreeHundred_dp"
    android:layout_height="@dimen/twohundred_fifty"
    android:layout_margin="@dimen/six_dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/eighteen_sp"
    app:cardElevation="@dimen/four_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- ── Title ──────────────────────────────────────────────────── -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/Fifteen_dp"
            android:text="Data Storage"
            android:textColor="@color/black"
            android:textSize="@dimen/Fifteen_dp"
         android:fontFamily="@font/gill_sans_bold" />

        <!-- ── Total Storage  |  Used ─────────────────────────────────── -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/Fifteen_dp"
                android:gravity="center"
                android:orientation="horizontal">

                <!-- Total Storage (left) -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Storage"
                        android:fontFamily="@font/gill_sans"
                        android:textColor="@color/grey_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_total_gb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="-- GB"
                        android:textColor="@color/black"
                        android:textSize="@dimen/eighteen_sp"
                        android:fontFamily="@font/gill_sans_bold" />
                </LinearLayout>

                <!-- Used (right-aligned) -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="end"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Used"
                        android:fontFamily="@font/gill_sans"
                        android:textColor="@color/grey_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_used_gb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gill_sans_bold"
                        android:text="-- GB"
                        android:textColor="@color/blue_dark"
                        android:textSize="@dimen/eighteen_sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- ── Donut chart (left) + Available stats (right) ───────────── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- PieChart donut -->
                <com.github.mikephil.charting.charts.PieChart
                    android:id="@+id/pie_chart_storage"
                    android:layout_width="120dp"
                    android:layout_height="120dp" />

                <!-- Available + percent -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="2dp"
                        android:text="Available"
                        android:fontFamily="@font/gill_sans"
                        android:textColor="@color/grey_text"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tv_available_gb"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:text="-- GB"
                        android:fontFamily="@font/gill_sans_bold"
                        android:textColor="@color/chart_green"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tv_usage_percent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0% used"
                        android:fontFamily="@font/gill_sans"
                        android:textColor="@color/grey_text"
                        android:textSize="@dimen/Twelve_dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Hidden views kept for StorageHolder backward-compat -->
            <TextView
                android:id="@+id/tv_storage_status"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>