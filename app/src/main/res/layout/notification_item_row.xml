<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:id="@+id/notification_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="72dp"
        android:orientation="horizontal"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- Blue Dot for unread -->
        <View
            android:id="@+id/view_unread_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="12dp"
            android:background="@drawable/blue_dot"
            android:visibility="gone" />

        <!-- Spacer when indicator is hidden -->
        <View
            android:id="@+id/view_indicator_space"
            android:layout_width="20dp"
            android:layout_height="match_parent"
            android:background="@android:color/transparent"
            android:visibility="visible" />

        <!-- Message and timestamp -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:layout_gravity="center"
            android:paddingEnd="8dp">

            <TextView
                android:id="@+id/tv_messageView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans"
                android:lineSpacingMultiplier="1.35"
                android:text="Notification message"
                android:textColor="@color/black"
                android:textSize="15sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:layout_marginEnd="4dp"
                    android:contentDescription="time"
                    android:src="@drawable/clock_blue" />

                <TextView
                    android:id="@+id/tv_timestampView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="09:55 AM"
                    android:textColor="#999999"
                    android:textSize="12sp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Checkbox -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:paddingEnd="12dp">

            <CheckBox
                android:id="@+id/chk_selected"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/checkbox_circle_selector"
                android:button="@null" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider at bottom -->
    <View
        android:id="@+id/divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="24dp"
        android:background="#E0E0E0"
        android:visibility="gone" />

</FrameLayout>