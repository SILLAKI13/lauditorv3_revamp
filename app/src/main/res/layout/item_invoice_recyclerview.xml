<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/four_dp">

    <!-- ── Invoice Card ───────────────────────────────────────────────────── -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cv_invoice_item"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/four_dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/four_dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ten_dp">

            <!-- Row 1: Client Name + Three Dot Menu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <include
                    android:id="@+id/tv_client_name"
                    layout="@layout/blue_bold_txt_layout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <ImageView
                    android:id="@+id/iv_action_btn"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="@dimen/four_dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:contentDescription="More options"
                    android:focusable="true"
                    android:padding="4dp"
                    android:scaleType="centerInside"
                    android:src="@drawable/img_17" />

            </LinearLayout>

            <!-- Row 2: Invoice Number -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/four_dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/invoice_number_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

                <TextView
                    android:id="@+id/tv_invoice_no"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/gill_sans"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

            </LinearLayout>

            <!-- Row 3: Create Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/two_dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/create_date_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

                <TextView
                    android:id="@+id/tv_create_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

            </LinearLayout>

            <!-- Row 4: Due Date -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/two_dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/due_date_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

                <TextView
                    android:id="@+id/tv_due_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

            </LinearLayout>

            <!-- Row 5: Created By -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/two_dp"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/created_by_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

                <TextView
                    android:id="@+id/tv_created_by"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="@font/gill_sans"
                    android:maxLines="1"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

            </LinearLayout>

            <!-- Row 6: Status Chip -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/four_dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/status_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Twelve_dp" />

                <TextView
                    android:id="@+id/tv_invoice_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/chip_pale_blue"
                    android:fontFamily="@font/gill_sans"
                    android:paddingStart="10dp"
                    android:paddingTop="3dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="3dp"
                    android:textSize="@dimen/Twelve_dp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!--
        ── Action dropdown (CardView styled list from action_layout_list) ──────
        Positioned absolutely at the END of the card row, with a top margin
        that pushes it just below the three-dot icon (~40dp from card top).
        visibility="gone" by default; toggled to VISIBLE in the adapter.
        z-elevation makes it draw ON TOP of everything below it.
    -->
    <include
        android:id="@+id/lv_invoice_actions"
        layout="@layout/action_layout_list"
        android:layout_width="@dimen/action_list_width"
        android:layout_height="@dimen/action_list_height_tm"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="40dp"
        android:elevation="16dp"
        android:visibility="gone" />

</RelativeLayout>