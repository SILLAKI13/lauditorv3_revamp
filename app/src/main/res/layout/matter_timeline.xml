<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/timeline_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/four_dp"
    android:layout_marginTop="@dimen/ten_dp"
    android:layout_marginEnd="@dimen/four_dp"
    android:layout_marginBottom="@dimen/four_dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal">
        <!-- First text view -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <include
                android:id="@+id/tv_timeline_title"
                layout="@layout/title_name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <include
                android:id="@+id/tv_timeline_date"
                layout="@layout/black_normal_txt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="@dimen/two_dp"
                android:layout_weight="1"
                android:textColor="@color/black" />
        </LinearLayout>

        <include
            layout="@layout/simple_icon_layout"
            android:layout_width="@dimen/thirty_five_dp"
            android:layout_height="@dimen/thirty_five_dp"
            android:layout_gravity="end"
            android:layout_marginEnd="@dimen/ten_dp"
            android:padding="@dimen/four_dp"
            android:visibility="visible" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/notes_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="visible">

        <include layout="@layout/radio_btn_notes" />

        <include
            android:id="@+id/rb_corporate_notes"
            layout="@layout/radio_btn_notes" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_add_notes"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:layout_weight="50"
        android:orientation="vertical"
        android:padding="@dimen/four_dp"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tv_add_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/four_dp"
                android:fontFamily="@font/gill_sans"
                android:text="@string/notes"
                android:textColor="@color/Blue_text_color"
                android:textSize="@dimen/Fifteen_dp" />

            <include layout="@layout/astrick_layout" />
        </LinearLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tl_add_description"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/four_dp"
            android:layoutDirection="rtl"
            android:textColorHint="@color/grey_color_dark"
            android:textDirection="ltr"
            app:boxBackgroundMode="none"
            app:counterEnabled="true"
            app:counterMaxLength="150"
            app:counterTextColor="@color/grey_color_dark">

            <include
                android:id="@+id/et_add_notes"
                layout="@layout/description_large_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one_fifty_dp"
                android:background="@drawable/rectangle_light_grey" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_gravity="end"
            android:layout_weight="1"
            android:orientation="horizontal">

            <include
                android:id="@+id/btn_add_cancel"
                layout="@layout/cancel_button"
                android:layout_width="@dimen/seventy_dp"
                android:layout_height="@dimen/thirty_five_dp" />

            <Space
                android:layout_width="@dimen/ten_dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <include
                android:id="@+id/btn_add_create"
                layout="@layout/submit_button"
                android:layout_width="@dimen/seventy_dp"
                android:layout_height="@dimen/thirty_five_dp" />
        </LinearLayout>
    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cv_matterTimeline"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ten_dp"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/ten_dp"
        app:cardElevation="@dimen/ten_dp">

        <LinearLayout
            android:id="@+id/linear_notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/ll_empty_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="50"
                android:orientation="horizontal"
                android:padding="@dimen/four_dp"
                android:visibility="visible">
                <!-- First image view at start of parent -->
                <TextView
                    android:id="@+id/normal_notes"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_margin="@dimen/four_dp"
                    android:background="@drawable/background_transparent"
                    android:ellipsize="end"
                    android:fontFamily="@font/gill_sans"
                    android:maxLines="1"
                    android:text="@string/are_you_sure_you_want_send_relationship_invite_to"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/ll_edit_notes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/four_dp"
                android:layout_weight="50"
                android:orientation="vertical"
                android:padding="@dimen/four_dp"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/m_c_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/four_dp"
                        android:fontFamily="@font/gill_sans"
                        android:text="@string/notes"
                        android:textColor="@color/Blue_text_color"
                        android:textSize="@dimen/Fifteen_dp" />

                    <include layout="@layout/astrick_layout" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tl_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/four_dp"
                    android:layoutDirection="rtl"
                    android:textColorHint="@color/grey_color_dark"
                    android:textDirection="ltr"
                    app:boxBackgroundMode="none"
                    app:counterEnabled="true"
                    app:counterMaxLength="150"
                    app:counterTextColor="@color/grey_color_dark">

                    <include
                        android:id="@+id/tv_edit_notes"
                        layout="@layout/title_description_layout"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/one_fifty_dp"
                        android:background="@drawable/rectangle_light_grey" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="0dp"
                    android:layout_gravity="end"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/btn_cancel_save"
                        layout="@layout/cancel_button"
                        android:layout_width="@dimen/seventy_dp"
                        android:layout_height="@dimen/thirty_five_dp" />

                    <Space
                        android:layout_width="@dimen/ten_dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/btn_create"
                        layout="@layout/submit_button"
                        android:layout_width="@dimen/seventy_dp"
                        android:layout_height="@dimen/thirty_five_dp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tv_view_notes"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one_fifty_dp"
                android:layout_weight="50"
                android:background="@drawable/rectangular_white_background"
                android:enabled="false"
                android:fontFamily="@font/gill_sans"
                android:hint=""
                android:inputType="textMultiLine"
                android:padding="@dimen/four_dp"
                android:textColor="@color/black"
                android:textSize="@dimen/Fifteen_dp"
                android:visibility="gone" />

            <!-- Space between first and second image views -->
            <!--            <Space-->
            <!--                android:layout_width="@dimen/zero_dp"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_weight="1" />-->

            <!-- Second and third image views adjacent to each other at end of parent -->
            <LinearLayout
                android:id="@+id/ll_icons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal"
                android:padding="@dimen/four_dp">

                <include
                    android:id="@+id/iv_notes"
                    layout="@layout/edit_icon"
                    android:layout_width="@dimen/thirty_dp"
                    android:layout_height="@dimen/thirty_dp" />

                <include
                    android:id="@+id/iv_view"
                    layout="@layout/eye_icon" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <LinearLayout
        android:id="@+id/ll_notes_items"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone"></LinearLayout>


</LinearLayout>
