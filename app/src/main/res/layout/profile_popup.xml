<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten_dp"
    android:background="@drawable/bg_popup_card"
    android:elevation="@dimen/four_dp"
    android:orientation="vertical"
    android:padding="0dp">
    <!--     &lt;!&ndash; Small Arrow &ndash;&gt; -->
    <!--     <ImageView -->
    <!--         android:id="@+id/arrow_up" -->
    <!--         android:layout_width="24dp" -->
    <!--         android:layout_height="@dimen/Fifteen_dp" -->
    <!--         android:layout_gravity="end" -->
    <!--         android:src="@drawable/ic_arrow_up" /> -->
    <!--  White Card  -->
    <LinearLayout
        android:id="@+id/card"
        android:layout_width="@dimen/ThreeHundred_dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/ten_dp"
        android:background="@drawable/bg_popup_card"
        android:orientation="vertical"
        android:padding="@dimen/ten_dp">
        <!--  Profile Photo + Circle  -->
        <TextView
            android:id="@+id/popup_person_icon"
            android:layout_width="@dimen/sixty_dp"
            android:layout_height="@dimen/sixty_dp"
            android:layout_gravity="center"
            android:layout_marginTop="4dp"
            android:background="@drawable/circular_button_background"
            android:clickable="false"
            android:focusable="false"
            android:gravity="center"
            android:text="Tr"
            android:textColor="@color/white"
            android:textSize="@dimen/twenty_two_dp"
            android:textStyle="bold"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/iv_profile"
            android:layout_width="@dimen/sixty_dp"
            android:layout_height="@dimen/sixty_dp"
            android:layout_gravity="center"
            android:background="@drawable/ic_profile_placeholder"
            android:scaleType="centerCrop"
            android:visibility="gone" />

        <!--  Name  -->
        <TextView
            android:id="@+id/tvName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:fontFamily="@font/gill_sans_bold"
            android:gravity="center"
            android:text="Hi, Tripura!"
            android:textColor="@color/grey_medium"
            android:textSize="@dimen/twenty_dp"
            android:textStyle="bold" />
        <!--  Email  -->
        <TextView
            android:id="@+id/tvEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="@font/gill_sans"
            android:gravity="center"
            android:text="tripura.inl@digicoffer.com"
            android:textColor="@color/grey_color_dark"
            android:textSize="@dimen/Fifteen_dp" />
        <!--  Role  -->
        <LinearLayout
            android:id="@+id/ll_role"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvRoleTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans_regular"
                android:text="Group Head"
                android:textColor="@color/Blue_text_color"
                android:textSize="@dimen/Fifteen_dp" />

            <TextView
                android:id="@+id/tvSeparator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans"
                android:text=" | "
                android:textColor="@color/Blue_text_color"
                android:textSize="@dimen/Fifteen_dp" />

            <TextView
                android:id="@+id/tvRoleCompany"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans_regular"
                android:text="Rax Professional"
                android:textColor="@color/Blue_text_color"
                android:textSize="@dimen/Fifteen_dp" />
        </LinearLayout>

        <!--  Switch Firm  -->
        <TextView
            android:id="@+id/btnSwitchFirm"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:fontFamily="@font/gill_sans_bold"
            android:text="@string/switch_firm"
            android:textColor="@color/grey_medium"
            android:textSize="@dimen/seventeen_dp"
            android:textStyle="bold" />
        <!--  Firm Row (Icon + Name)  -->
        <LinearLayout
            android:id="@+id/layout_firm_parent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:orientation="vertical"
            android:padding="@dimen/five_dp">

            <!-- Existing horizontal row -->
            <LinearLayout
                android:id="@+id/layout_firm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/iconFirm"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_marginEnd="@dimen/ten_dp"
                    android:background="@drawable/circular_button_background"
                    android:fontFamily="@font/gill_sans_bold"
                    android:gravity="center"
                    android:text="So"
                    android:textColor="@color/white"
                    android:textSize="@dimen/Twelve_dp" />

                <TextView
                    android:id="@+id/tvFirm"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:fontFamily="@font/gill_sans_regular"
                    android:text="Soundarya StageLauditor Firm"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />
            </LinearLayout>

        </LinearLayout>
        <!-- Logout Button -->
        <LinearLayout
            android:id="@+id/btnLogout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:background="@drawable/rectangle_blue_bg"
            android:clickable="true"
            android:elevation="@dimen/four_dp"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/ten_dp">

            <ImageView
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:padding="@dimen/two_dp"
                android:src="@drawable/logout_image"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/text_log"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten_dp"
                android:fontFamily="@font/gill_sans"
                android:text="@string/logout"
                android:textColor="@color/white"
                android:textSize="@dimen/eighteen_sp" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>