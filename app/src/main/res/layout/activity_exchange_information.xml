<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_pale"
    android:fitsSystemWindows="true"
    android:orientation="vertical">

    <!-- Custom Header -->
    <include layout="@layout/custom_header" />

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ten_dp">

            <!-- PROFILE CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/two_dp"
                app:cardBackgroundColor="@color/white"
                app:cardCornerRadius="@dimen/ten_dp"
                app:cardElevation="@dimen/four_dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/Fifteen_dp">

                    <!-- Avatar + name + Hide/Show details toggle row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <!-- Avatar circle -->
                        <TextView
                            android:id="@+id/tv_exc_avatar"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:background="@drawable/rounder_button_dark_blue"
                            android:gravity="center"
                            android:text="T"
                            android:textColor="#FFFFFF"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Name + email column -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:paddingStart="12dp">

                            <include
                                android:id="@+id/tv_exc_name"
                                layout="@layout/black_small_bold_txt" />

                            <include
                                android:id="@+id/tv_exc_email_under_name"
                                layout="@layout/grey_normal_txt" />
                        </LinearLayout>

                        <!-- Hide / Show details toggle -->
                        <TextView
                            android:id="@+id/tv_exc_toggle_details"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:fontFamily="@font/gill_sans"
                            android:paddingStart="@dimen/five_dp"
                            android:paddingEnd="@dimen/five_dp"
                            android:text="Hide details"
                            android:textColor="@color/blue"
                            android:textSize="@dimen/Twelve_dp" />

                        <ImageView
                            android:id="@+id/iv_dropdown"
                            android:layout_width="@dimen/Fifteen_dp"
                            android:layout_height="@dimen/Fifteen_dp"
                            android:src="@drawable/drop_down_blue" />

                    </LinearLayout>

                    <!-- Horizontal rule -->
                    <include layout="@layout/divider_line" />

                    <!-- Collapsible details wrapper -->
                    <LinearLayout
                        android:id="@+id/ll_exc_profile_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <!-- ENTITY profile -->
                        <LinearLayout
                            android:id="@+id/ll_exc_entity_profile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="visible">

                            <!-- Contact Person -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/ten_dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/forty_dp"
                                    android:layout_height="@dimen/forty_dp"
                                    android:layout_marginEnd="@dimen/ten_dp"
                                    android:padding="8dp"
                                    android:src="@drawable/person_icon" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:text="Contact Person"
                                        android:textColor="@color/blue"
                                        android:textSize="@dimen/Fifteen_dp" />

                                    <TextView
                                        android:id="@+id/tv_exc_contact_val"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Country -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/ten_dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/forty_dp"
                                    android:layout_height="@dimen/forty_dp"
                                    android:layout_marginEnd="@dimen/ten_dp"
                                    android:padding="8dp"
                                    android:src="@drawable/location_icon" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:text="Country"
                                        android:textColor="@color/blue"
                                        android:textSize="@dimen/Fifteen_dp" />

                                    <TextView
                                        android:id="@+id/tv_exc_country_val"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Phone -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/ten_dp"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/forty_dp"
                                    android:layout_height="@dimen/forty_dp"
                                    android:layout_marginEnd="@dimen/ten_dp"
                                    android:padding="8dp"
                                    android:src="@drawable/phone_icon" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:text="Phone"
                                        android:textColor="@color/blue"
                                        android:textSize="@dimen/Fifteen_dp" />

                                    <TextView
                                        android:id="@+id/tv_exc_phone_val"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Address -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="@dimen/ten_dp"
                                android:gravity="center_vertical"
                                android:visibility="gone"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/forty_dp"
                                    android:layout_height="@dimen/forty_dp"
                                    android:layout_marginEnd="@dimen/ten_dp"
                                    android:padding="8dp"

                                    android:src="@drawable/location_icon" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:text="Address"
                                        android:textColor="@color/blue"
                                        android:textSize="@dimen/Fifteen_dp" />

                                    <TextView
                                        android:id="@+id/tv_exc_address_val"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Website -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center_vertical"
                                android:orientation="horizontal">

                                <ImageView
                                    android:layout_width="@dimen/forty_dp"
                                    android:layout_height="@dimen/forty_dp"
                                    android:layout_marginEnd="@dimen/ten_dp"
                                    android:padding="8dp"
                                    android:src="@drawable/website" />

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:text="Website"
                                        android:textColor="@color/blue"
                                        android:textSize="@dimen/Fifteen_dp" />

                                    <TextView
                                        android:id="@+id/tv_exc_website_val"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:fontFamily="@font/gill_sans"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>
                            </LinearLayout>

                        </LinearLayout>
                        <!-- end ll_exc_entity_profile -->

                        <!-- INDIVIDUAL profile -->
                        <LinearLayout
                            android:id="@+id/ll_exc_individual_profile"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="First Name"
                                        android:textColor="@color/blue"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_exc_ind_fname"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>

                                <LinearLayout
                                    android:layout_width="0dp"
                                    android:layout_height="wrap_content"
                                    android:layout_weight="1"
                                    android:orientation="vertical"
                                    android:visibility="gone">

                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Last Name"
                                        android:textColor="@color/blue"
                                        android:textSize="10sp"
                                        android:textStyle="bold" />

                                    <TextView
                                        android:id="@+id/tv_exc_ind_lname"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/Fifteen_dp" />
                                </LinearLayout>
                            </LinearLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Email"
                                android:textColor="@color/blue"
                                android:textSize="10sp"
                                android:textStyle="bold"
                                android:visibility="gone" />

                            <TextView
                                android:id="@+id/tv_exc_ind_email"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:textColor="@color/black"
                                android:textSize="@dimen/Fifteen_dp"
                                android:visibility="gone" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Mobile"
                                android:textColor="@color/blue"
                                android:textSize="@dimen/Fifteen_dp"
                              android:fontFamily="@font/gill_sans" />

                            <TextView
                                android:id="@+id/tv_exc_ind_mobile"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/gill_sans"
                                android:textSize="@dimen/Fifteen_dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Country"
                                android:textColor="@color/blue"
                                android:textSize="@dimen/Fifteen_dp"
                                android:fontFamily="@font/gill_sans" />

                            <TextView
                                android:id="@+id/tv_exc_ind_country"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/gill_sans"
                                android:textSize="@dimen/Fifteen_dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Home Address"
                                android:textColor="@color/blue"
                                android:textSize="@dimen/Fifteen_dp"
                                android:fontFamily="@font/gill_sans" />

                            <TextView
                                android:id="@+id/tv_exc_ind_home"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/gill_sans"
                                android:textSize="@dimen/Fifteen_dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Work Phone"
                                android:textColor="@color/blue"
                                android:textSize="@dimen/Fifteen_dp"
                                android:fontFamily="@font/gill_sans"/>

                            <TextView
                                android:id="@+id/tv_exc_ind_work"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="8dp"
                                android:textColor="@color/black"
                                android:fontFamily="@font/gill_sans"
                                android:textSize="@dimen/Fifteen_dp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Alt Phone"
                                android:textColor="@color/blue"
                                android:textSize="@dimen/Fifteen_dp"
                                android:fontFamily="@font/gill_sans"/>

                            <TextView
                                android:id="@+id/tv_exc_ind_alt"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:fontFamily="@font/gill_sans"
                                android:textSize="@dimen/Fifteen_dp" />

                        </LinearLayout>
                        <!-- end ll_exc_individual_profile -->

                    </LinearLayout>
                    <!-- end ll_exc_profile_details -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- end Profile card -->

            <androidx.cardview.widget.CardView
                android:id="@+id/share_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/two_dp"
                android:layout_marginTop="@dimen/ten_dp"
                android:layout_marginEnd="@dimen/two_dp"
                android:layout_marginBottom="@dimen/two_dp"
                app:cardBackgroundColor="#FFFFFF"
                app:cardCornerRadius="@dimen/ten_dp"
                app:cardElevation="@dimen/four_dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/Fifteen_dp">

                    <!-- Section header + Share button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ten_dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:fontFamily="@font/gill_sans"
                            android:text="@string/shared_documents"
                            android:textColor="@color/grey_medium"
                            android:textSize="@dimen/Fifteen_dp" />

                        <ImageView
                            android:id="@+id/btn_exc_share"
                            android:layout_width="@dimen/forty_dp"
                            android:layout_height="@dimen/forty_dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:clickable="true"
                            android:focusable="true"
                            android:padding="@dimen/four_dp"
                            android:src="@drawable/share_btn" />

                    </LinearLayout>

                    <include layout="@layout/divider_line" />

                    <!-- Share With Me / Share By Me toggle -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ten_dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/rb_exc_share_with_me"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/forty_dp"
                            android:layout_marginEnd="@dimen/one_dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_left_green_round_background"
                            android:fontFamily="@font/gill_sans"
                            android:gravity="center"
                            android:text="Shared With Me"
                            android:textColor="@color/white"
                            android:textSize="@dimen/Fifteen_dp" />

                        <TextView
                            android:id="@+id/rb_exc_share_by_me"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/forty_dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_right_round_background"
                            android:fontFamily="@font/gill_sans"
                            android:gravity="center"
                            android:text="Shared By Me"
                            android:textColor="@color/black"
                            android:textSize="@dimen/Fifteen_dp" />

                    </LinearLayout>

                    <!-- Client Doc / Firm Doc sub-toggle -->
                    <LinearLayout
                        android:id="@+id/ll_exc_doc_type_row"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/rb_exc_client_doc"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_marginEnd="3dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_left_background"
                            android:gravity="center"
                            android:text="Client Documents"
                            android:textColor="#000000"
                            android:textSize="@dimen/Twelve_dp" />

                        <TextView
                            android:id="@+id/rb_exc_firm_doc"
                            android:layout_width="0dp"
                            android:layout_height="34dp"
                            android:layout_weight="1"
                            android:background="@drawable/button_right_background"
                            android:gravity="center"
                            android:text="Firm Documents"
                            android:textColor="#000000"
                            android:textSize="@dimen/Twelve_dp" />

                    </LinearLayout>

                    <!-- Empty state -->
                    <TextView
                        android:id="@+id/tv_exc_no_docs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/gill_sans"
                        android:gravity="center"
                        android:paddingTop="20dp"
                        android:paddingBottom="20dp"
                        android:text="No documents to show"
                        android:textColor="#AAAAAA"
                        android:textSize="@dimen/Fifteen_dp"
                        android:visibility="gone" />

                    <!-- Document RecyclerView -->
                    <include
                        android:id="@+id/rv_exc_shared_docs"
                        layout="@layout/recyclerview" />

                    <!-- Cancel + Share button bar -->
                    <LinearLayout
                        android:id="@+id/ll_exc_share_byme_actions"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:layout_gravity="bottom"
                        android:background="#FFFFFF"
                        android:elevation="8dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="16dp"
                        android:paddingTop="@dimen/ten_dp"
                        android:paddingEnd="16dp"
                        android:paddingBottom="@dimen/ten_dp"
                        android:visibility="gone">

                        <include
                            android:id="@+id/btn_exc_action_cancel"
                            layout="@layout/cancel_button" />

                        <include
                            android:id="@+id/btn_exc_action_share"
                            layout="@layout/submit_button" />

                    </LinearLayout>
                    <!-- end ll_exc_share_byme_actions -->

                </LinearLayout>
            </androidx.cardview.widget.CardView>
            <!-- end Shared Documents card -->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</LinearLayout>