<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/four_dp"
    android:paddingEnd="@dimen/four_dp">

    <!-- Timeline indicator column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:gravity="start"
        android:orientation="vertical"
        android:paddingEnd="@dimen/ten_dp">

        <!-- Green dot -->
        <View
            android:id="@+id/timeline_dot"
            android:layout_width="@dimen/Fifteen_dp"
            android:layout_height="@dimen/Fifteen_dp"
            android:layout_marginTop="@dimen/ten_dp"
            android:background="@drawable/green_circular"
            android:elevation="@dimen/four_dp" />

        <!-- Vertical line -->
        <View
            android:id="@+id/timeline_line"
            android:layout_width="@dimen/two_dp"
            android:layout_height="match_parent"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/two_dp"
            android:background="@color/grey" />

    </LinearLayout>

    <!-- Content column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/ten_dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Appointment header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <include
                android:id="@+id/tv_appointment_title"
                layout="@layout/semibold_textview"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btn_add_note"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/thirty_dp"
                android:background="@drawable/save_button_background"
                android:text="@string/add_note"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/Twelve_dp"
                android:visibility="visible" />

        </LinearLayout>

        <!-- Date and time -->
        <TextView
            android:id="@+id/tv_appointment_datetime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/four_dp"
            android:fontFamily="@font/gill_sans"
            android:text="Jan 29, 2026 | 15:30 - 16:00"
            android:textColor="@color/dark_grey_new"
            android:textSize="@dimen/Fifteen_dp" />

        <!-- Payment info -->
        <TextView
            android:id="@+id/tv_payment_info"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/four_dp"
            android:fontFamily="@font/gill_sans"
            android:text="Payment: ₹5000"
            android:textColor="@color/dark_grey_new"
            android:textSize="@dimen/Fifteen_dp" />

        <!-- Status badge -->
        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten_dp"
            android:background="@drawable/completed_badge"
            android:fontFamily="@font/gill_sans"
            android:paddingStart="@dimen/ten_dp"
            android:paddingTop="@dimen/four_dp"
            android:paddingEnd="@dimen/ten_dp"
            android:paddingBottom="@dimen/four_dp"
            android:text="Completed"
            android:textColor="@color/black"
            android:textSize="@dimen/Twelve_dp" />

        <!-- Note input section -->
        <LinearLayout
            android:id="@+id/ll_note_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/four_dp"
            android:layout_marginTop="@dimen/ten_dp"
            android:layout_marginEnd="@dimen/four_dp"
            android:layout_marginBottom="@dimen/four_dp"
            android:background="@drawable/rectangular_white_background"
            android:elevation="@dimen/four_dp"
            android:orientation="vertical"
            android:padding="@dimen/ten_dp"
            android:visibility="gone">

            <!-- Note input field -->
            <EditText
                android:id="@+id/et_note_input"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one_thiry_dp"
                android:background="@drawable/light_grey_bg"
                android:fontFamily="@font/gill_sans"
                android:gravity="start|top"
                android:hint="Notes"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:padding="@dimen/ten_dp"
                android:textColor="@color/black"
                android:textColorHint="@color/dark_grey_new"
                android:textSize="@dimen/Fifteen_dp" />

            <!-- Character counter and buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tv_char_counter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten_dp"
                    android:layout_weight="1"
                    android:text="0/500"
                    android:textColor="@color/dark_grey_new"
                    android:textSize="@dimen/Twelve_dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_cancel_note"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/thirty_five_dp"
                    android:layout_marginEnd="@dimen/ten_dp"
                    android:background="@drawable/cancel_button_background"
                    android:fontFamily="@font/gill_sans"
                    android:paddingStart="@dimen/Fifteen_dp"
                    android:paddingEnd="@dimen/Fifteen_dp"
                    android:text="@string/cancel"
                    android:textAllCaps="false"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btn_save_note"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/thirty_five_dp"
                    android:background="@drawable/save_button_background"
                    android:fontFamily="@font/gill_sans"
                    android:paddingStart="@dimen/twenty_dp"
                    android:paddingEnd="@dimen/twenty_dp"
                    android:text="@string/save"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/Fifteen_dp" />

            </LinearLayout>

        </LinearLayout>

        <!-- Existing notes list -->
        <LinearLayout
            android:id="@+id/llNotesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            android:visibility="gone" />

    </LinearLayout>

</LinearLayout>