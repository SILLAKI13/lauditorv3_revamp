<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/tv_content"
            layout="@layout/title_name_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1" />

        <include
            android:id="@+id/iv_remove"
            layout="@layout/simple_cancel_icon"
            android:layout_width="@dimen/thirty_dp"
            android:layout_height="@dimen/thirty_dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_column_headers"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_marginTop="@dimen/four_dp"
        android:layout_marginEnd="@dimen/four_dp"
        android:layout_gravity="end"
        android:gravity="end"
        android:layout_marginBottom="@dimen/four_dp"
        android:orientation="horizontal" >
    </LinearLayout>


    <LinearLayout
        android:id="@+id/ll_add_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/ll_add_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:orientation="horizontal"
        android:weightSum="8">

        <include
            android:id="@+id/btn_addColumn"
            layout="@layout/add_button" />

        <include
            android:id="@+id/btn_addRow"
            layout="@layout/add_button" />
    </LinearLayout>
</LinearLayout>