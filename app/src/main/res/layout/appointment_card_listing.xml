<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- ── Main Card ── -->
    <LinearLayout
        android:id="@+id/appointment_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ten_dp"
        android:layout_marginTop="@dimen/five_dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/five_dp"
        android:background="@drawable/rectangular_white_background"
        android:elevation="@dimen/four_dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ten_dp">

            <!-- ── Top Row: Profile + Client Name + Three-dot menu ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_toStartOf="@+id/custom_spinner_cardview"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_profile"
                        android:layout_width="@dimen/thirty_dp"
                        android:layout_height="@dimen/thirty_dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/ic_profile_placeholder"
                        android:padding="@dimen/one_dp" />

                    <include
                        android:id="@+id/person_icon"
                        layout="@layout/person_icon"
                        android:layout_width="@dimen/thirty_dp"
                        android:layout_height="@dimen/thirty_dp"
                        android:visibility="gone" />

                    <include
                        android:id="@+id/tv_client_name"
                        layout="@layout/semibold_textview" />

                </LinearLayout>

                <ImageView
                    android:id="@+id/custom_spinner_cardview"
                    android:layout_width="@dimen/thirty_dp"
                    android:layout_height="@dimen/thirty_dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:clickable="true"
                    android:focusable="true"
                    android:foreground="?android:attr/selectableItemBackgroundBorderless"
                    android:padding="@dimen/four_dp"
                    android:src="@drawable/img_17" />

            </RelativeLayout>


            <!-- ── Date / Time Row ── -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/iv_calendar_icon"
                    android:layout_width="@dimen/twenty_dp"
                    android:layout_height="@dimen/twenty_dp"
                    android:layout_marginEnd="@dimen/five_dp"
                    android:src="@drawable/img"
                    app:tint="@color/dark_grey_new" />

                <TextView
                    android:id="@+id/tv_appointment_datetime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="Jan 29, 2026 • 8:00 PM - 8:30 PM"
                    android:textColor="@color/dark_grey_new"
                    android:textSize="@dimen/Thirteen_dp" />

            </LinearLayout>

            <!-- ── Payment Status ── -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp">

                <TextView
                    android:id="@+id/tv_payment_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/ten_dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Pending - ₹0"
                    android:textColor="@color/orange_color"
                    android:textSize="@dimen/Fifteen_dp"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </RelativeLayout>

            <!-- ── Bottom Row: Status badge + Chat/Video icons ── -->
            <RelativeLayout
                android:id="@+id/rl_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp">

                <TextView
                    android:id="@+id/tv_appointment_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@drawable/pending_badge"
                    android:fontFamily="@font/gill_sans"
                    android:paddingStart="@dimen/ten_dp"
                    android:paddingTop="@dimen/five_dp"
                    android:paddingEnd="@dimen/ten_dp"
                    android:paddingBottom="@dimen/five_dp"
                    android:text="Payment Pending"
                    android:textColor="@color/pending_text"
                    android:textSize="@dimen/Twelve_dp" />

                <LinearLayout
                    android:id="@+id/ll_actions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/iv_chat"
                        android:layout_width="@dimen/thirty_dp"
                        android:layout_height="@dimen/thirty_dp"
                        android:layout_gravity="center_vertical"
                        android:layout_marginEnd="@dimen/four_dp"
                        android:background="@drawable/scheduled_badge"
                        android:padding="@dimen/eight_dp"
                        android:src="@drawable/message_icon"
                        android:visibility="gone"
                        app:tint="@color/blue_dark" />

                    <ImageView
                        android:id="@+id/iv_video_call"
                        android:layout_width="@dimen/thirty_dp"
                        android:layout_height="@dimen/thirty_dp"
                        android:layout_gravity="center_vertical"
                        android:background="@drawable/completed_badge"
                        android:padding="@dimen/eight_dp"
                        android:src="@drawable/videocall_icon"
                        android:visibility="gone"
                        app:tint="@color/completed_text" />

                </LinearLayout>

            </RelativeLayout>

            <!-- Legacy action_layout -->
            <LinearLayout
                android:id="@+id/action_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

        </LinearLayout>

    </LinearLayout>

    <!--
        ── Action List Card ──────────────────────────────────────────────────────
        Sits inside the same FrameLayout as the main card.
        Because FrameLayout does NOT resize itself to fit this child when it is
        GONE, showing it does NOT push the next RecyclerView item downward.
        High elevation (16dp) ensures it floats visually above all other cards.
        layout_marginTop="40dp" positions the dropdown just below the three-dot
        icon row (approx top-row height). Adjust this value if needed.
    -->
    <androidx.cardview.widget.CardView
        android:id="@+id/action_list_card"
        android:layout_width="@dimen/one_fifty_dp"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginTop="40dp"
        android:elevation="16dp"
        android:translationZ="16dp"
        android:visibility="gone"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/six_dp"
        app:cardElevation="16dp">

        <ListView
            android:id="@+id/list_actions"
            android:layout_width="@dimen/one_fifty_dp"
            android:layout_height="wrap_content"
            android:background="@android:color/white"
            android:divider="@android:color/transparent"
            android:dividerHeight="0dp" />

    </androidx.cardview.widget.CardView>

</FrameLayout>