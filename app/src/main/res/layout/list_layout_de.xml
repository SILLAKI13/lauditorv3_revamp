<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/tv_content"
            layout="@layout/title_name_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_weight="1" />

        <include
            android:id="@+id/iv_remove"
            layout="@layout/simple_cancel_icon"
            android:layout_width="@dimen/thirty_dp"
            android:layout_height="@dimen/thirty_dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_add_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:orientation="vertical" />

    <LinearLayout
        android:id="@+id/ll_add_more"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:focusable="true"
        android:focusableInTouchMode="true">

        <ImageView
            android:id="@+id/iv_plus_icon"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_margin="@dimen/ten_dp"
            android:src="@drawable/plus_icon"
            app:tint="@color/blue" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:fontFamily="@font/gill_sans"
            android:text="Add More"
            android:textColor="@color/blue"
            android:textSize="@dimen/Fifteen_dp" />
    </LinearLayout>
</LinearLayout>