<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rectangular_white_background"
    android:elevation="@dimen/four_dp"
    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <include
        android:id="@+id/iv_cancel_icon"
        layout="@layout/simple_cancel_icon"
        android:layout_width="@dimen/thirty_dp"
        android:layout_height="@dimen/thirty_dp"
        android:layout_gravity="end"
        android:layout_marginBottom="-10dp" />

    <include
        android:id="@+id/tv_file_name"
        layout="@layout/blue_normal_txt"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="-10dp" />

    <include
        android:id="@+id/et_file_name"
        layout="@layout/title_description_layout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/forty_dp"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/four_dp"
        android:layout_marginBottom="@dimen/zero_dp" />

    <include
        android:id="@+id/tv_error_msg"
        layout="@layout/title_name_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/four_dp"
        android:visibility="gone" />

    <include
        android:id="@+id/btn_save_file"
        layout="@layout/submit_button"
        android:layout_width="@dimen/module_btn_size"
        android:layout_height="@dimen/forty_dp"
        android:layout_gravity="end"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/four_dp" />


</LinearLayout>