<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".MainActivity">

    <!-- Title Row -->
    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/linearLayoutCompat"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="horizontal"
        android:visibility="gone">

        <include
            android:id="@+id/tv_create"
            layout="@layout/left_title_layout" />

        <include
            android:id="@+id/tv_view"
            layout="@layout/right_title_layout" />
    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_buttons"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/six_dp"
        android:layout_marginEnd="@dimen/Twelve_dp"
        android:orientation="vertical">

        <include
            android:id="@+id/tv_switchView"
            layout="@layout/common_title_icon" />

        <include
            android:id="@+id/tv_switchCreate"
            layout="@layout/common_title_icon" />
    </androidx.appcompat.widget.LinearLayoutCompat>


    <!-- Main Create View -->
    <LinearLayout
        android:id="@+id/ll_create_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/twenty_dp"
        android:layout_marginTop="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/twenty_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:layout_weight="1"
        android:baselineAligned="false"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Dropdown Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/one_dp"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <include
                android:id="@+id/tv_file"
                layout="@layout/spinner_dropdown_layout_de"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/one_dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/tv_insert"
                layout="@layout/spinner_dropdown_layout_de"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />
        </LinearLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_documents"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginBottom="@dimen/four_dp"
            android:background="@drawable/rectangular_white_background"
            android:padding="@dimen/four_dp" />

        <!-- Scrollable Document Area -->
        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/ll_create_document"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten_dp"
                android:background="@drawable/rectangular_white_background"
                android:orientation="vertical"
                android:padding="@dimen/four_dp">

                <!-- Document Fields -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tv_doc_name"
                        layout="@layout/blue_bold_txt"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/two_dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/iv_eye_icon"
                        layout="@layout/eye_icon"
                        android:layout_width="@dimen/thirty_five_dp"
                        android:layout_height="@dimen/thirty_five_dp" />

                </LinearLayout>

                <include
                    android:id="@+id/tv_title"
                    layout="@layout/title_name_layout" />

                <include
                    android:id="@+id/et_title"
                    layout="@layout/title_description_layout" />

                <include
                    android:id="@+id/tv_author"
                    layout="@layout/title_name_layout" />

                <include
                    android:id="@+id/et_author"
                    layout="@layout/title_description_layout" />

            </LinearLayout>
        </ScrollView>
    </LinearLayout>

    <!-- View Doc Section -->
    <LinearLayout
        android:id="@+id/ll_view_doc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="gone">

        <include
            android:id="@+id/et_search_document"
            layout="@layout/search_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty_dp"
            android:layout_marginTop="@dimen/ten_dp"
            android:layout_marginEnd="@dimen/twenty_dp"
            android:layout_marginBottom="@dimen/ten_dp" />

        <include
            android:id="@+id/tv_list_doc"
            layout="@layout/title_name_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty_dp" />

        <include
            android:id="@+id/rv_viewDocEditor"
            layout="@layout/recyclerview" />
    </LinearLayout>
</LinearLayout>
