<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/timeline_c"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_margin="@dimen/four_dp"
    android:background="@drawable/background_transparent"
    android:baselineAligned="false"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginStart="@dimen/zero_dp"
        android:layout_marginTop="@dimen/four_dp"
        android:layout_marginEnd="@dimen/four_dp"
        android:elevation="@dimen/four_dp"
        android:gravity="end"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/header_name"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forty_dp"
            android:layout_gravity="bottom"
            android:layout_marginStart="@dimen/ten_dp"
            android:layout_marginEnd="@dimen/four_dp"
            android:layout_marginBottom="@dimen/one_dp"
            android:layout_weight="1.5"
            android:autoSizeMaxTextSize="@dimen/Fifteen_dp"
            android:autoSizeMinTextSize="@dimen/five_dp"
            android:autoSizeTextType="uniform"
            android:background="@drawable/rectangular_white_background"
            android:elevation="@dimen/four_dp"
            android:fontFamily="@font/gill_sans"
            android:gravity="center"
            android:padding="@dimen/eight_dp"
            android:text="@string/matter"
            android:textColor="@color/blue" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_margin="@dimen/four_dp"
            android:layout_weight="2"
            android:background="@drawable/background_transparent"
            android:gravity="end">

            <FrameLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/four_dp">

<!--                <ImageView-->
<!--                    android:layout_width="@dimen/forty_dp"-->
<!--                    android:layout_height="@dimen/forty_dp"-->
<!--                    android:layout_marginTop="@dimen/Twelve_dp"-->
<!--                    android:layout_marginEnd="@dimen/ten_dp"-->
<!--                    android:src="@drawable/calendar_icon"-->
<!--                    app:tint="@color/white" />-->

                <ImageView
                    android:id="@+id/close_details"
                    android:layout_width="@dimen/thirty_five_dp"
                    android:layout_height="@dimen/thirty_five_dp"
                    android:layout_gravity="end"
                    android:src="@drawable/cancel_icon_1" />
            </FrameLayout>

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/ll_timeLine"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginStart="@dimen/ten_dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:background="@drawable/rectangular_white_background"
        android:elevation="@dimen/four_dp"
        android:orientation="vertical"
        android:padding="@dimen/ten_dp" />

    <!--    <ImageView-->
    <!--        android:id="@+id/cancel"-->
    <!--        android:layout_width="@dimen/forty_dp"-->
    <!--        android:layout_height="@dimen/forty_dp"-->
    <!--        android:layout_gravity="end"-->
    <!--        android:layout_margin="@dimen/four_dp"-->
    <!--        android:contentDescription="@string/tag"-->
    <!--        android:src="@drawable/cancel_white_icon" />-->
</LinearLayout>
