<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/Card_Layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten_dp"
    android:background="@drawable/rectangular_white_background"
    android:elevation="@dimen/four_dp"
    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="top"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/Card_Image"
            android:layout_width="@dimen/forty_dp"
            android:layout_height="@dimen/forty_dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginEnd="@dimen/ten_dp"
            android:background="@drawable/timesheet_icon"
            android:contentDescription="@string/todo" />

        <include
            android:id="@+id/Card_Name"
            layout="@layout/blue_normal_txt"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />


    </androidx.appcompat.widget.LinearLayoutCompat>

    <androidx.appcompat.widget.LinearLayoutCompat
        android:id="@+id/ll_2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/twenty_dp"
        android:gravity="start"
        android:orientation="horizontal">

        <include
            android:id="@+id/total_tm"
            layout="@layout/timesheet_card_layout" />

        <include layout="@layout/side_line_layout" />

        <include
            android:id="@+id/ns_tm"
            layout="@layout/timesheet_card_layout" />

        <include layout="@layout/side_line_layout" />

        <include
            android:id="@+id/s_tm"
            layout="@layout/timesheet_card_layout" />

    </androidx.appcompat.widget.LinearLayoutCompat>

</LinearLayout>