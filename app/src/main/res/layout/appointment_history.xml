<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue_pale"
    android:orientation="vertical"
    android:padding="@dimen/ten_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="@dimen/two_dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/iv_close_history"
                android:layout_width="@dimen/twenty_dp"
                android:layout_height="@dimen/twenty_dp"
                android:layout_gravity="center"
                android:background="@drawable/back_arrow"
                android:backgroundTint="@color/blue"
                android:padding="@dimen/ten_dp" />


            <include
                android:id="@+id/tv_appointment_history"
                layout="@layout/semibold_textview" />

            <ImageView
                android:id="@+id/iv_profile"
                android:layout_width="@dimen/thirty_dp"
                android:layout_height="@dimen/thirty_dp"
                android:layout_gravity="center_vertical"
                android:background="@drawable/ic_profile_placeholder"
                android:padding="@dimen/one_dp" />

            <include
                android:id="@+id/person_icon"
                layout="@layout/person_icon"
                android:layout_width="@dimen/thirty_dp"
                android:layout_height="@dimen/thirty_dp"
                android:visibility="gone" />

            <include
                android:id="@+id/tv_client_name"
                layout="@layout/semibold_textview" />
        </LinearLayout>

        <!-- Timeline tab button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btn_timeline"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/forty_dp"
            android:layout_marginTop="@dimen/ten_dp"
            android:layout_marginBottom="@dimen/one_dp"
            android:background="@drawable/rectangular_button_green_count"
            android:fontFamily="@font/gill_sans"
            android:paddingStart="@dimen/twenty_dp"
            android:paddingEnd="@dimen/twenty_dp"
            android:text="Timeline"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/Fifteen_dp"
            android:visibility="gone" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_dp"
        android:layout_marginTop="@dimen/six_dp"
        android:layout_marginBottom="@dimen/six_dp"
        android:background="@color/grey_color_dark" />

    <!-- Appointments Timeline RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_appointments_timeline"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingTop="@dimen/ten_dp"
        android:paddingBottom="@dimen/ten_dp"
        android:scrollbars="vertical" />

</LinearLayout>