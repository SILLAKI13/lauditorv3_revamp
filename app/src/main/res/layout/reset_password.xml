<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blue"
    tools:context=".LoginActivity.ViewModels.reset_password_file">

    <!--cardview for Layout Design-->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/thirty_dp"
        app:cardCornerRadius="@dimen/thirty_dp"
        app:cardElevation="@dimen/thirty_dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        tools:layout_editor_absoluteY="59dp"
        tools:ignore="MissingConstraints">

        <!--Layout for card Design-->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:background="@color/white"
            android:orientation="vertical"
            android:padding="24dp">

            <!--Logo for Lauditor Design-->
            <include layout="@layout/logo_layout"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="@dimen/thirty_dp"
                android:id="@+id/reset_password"
                android:textColor="@color/black"
                android:layout_gravity="center_horizontal"
                android:text="Reset Password"
                android:fontFamily="@font/gill_sans"
                android:textSize="@dimen/twenty_dp"/>

            <TextView
                android:layout_width="254dp"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="@font/gill_sans"
                android:text="Enter password"
                android:textSize="@dimen/Fifteen_dp" />

            <include layout="@layout/password_layout"/>

            <TextView
                android:layout_width="254dp"
                android:layout_gravity="center"
                android:layout_height="wrap_content"
                android:fontFamily="@font/gill_sans"
                android:text="Re Enter password"
                android:textSize="@dimen/Fifteen_dp" />
            <include layout="@layout/password_layout"/>

            <include
                layout="@layout/submit_cancel"/>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>