<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/con_id"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- Search -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginEnd="@dimen/ten_dp"
        android:layout_marginStart="@dimen/ten_dp"
        android:layout_marginBottom="@dimen/ten_dp"
        android:orientation="horizontal">

        <include
            android:id="@+id/tl_search_matter"
            layout="@layout/searchbar_with_button"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forty_dp"
            android:layout_weight="1" />
    </LinearLayout>

    <!-- RecyclerView takes remaining space -->
    <!-- RecyclerView takes remaining space -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rv_matter_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_margin="@dimen/two_dp"
        android:layout_weight="1"
        android:orientation="vertical" />

    <!-- Buttons ALWAYS at bottom -->
    <LinearLayout
        android:id="@+id/ll_nav_buttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:gravity="end"
        android:orientation="horizontal"
        android:padding="@dimen/ten_dp">

        <include
            android:id="@+id/btn_prev"
            layout="@layout/add_button" />

        <include
            android:id="@+id/btn_next"
            layout="@layout/add_button" />

    </LinearLayout>

</LinearLayout>
