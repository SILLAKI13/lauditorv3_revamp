<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/ten_dp"
    android:layout_marginTop="@dimen/ten_dp"
    android:elevation="@dimen/four_dp"
    android:background="@drawable/rectangular_white_background"
    android:layout_marginEnd="@dimen/ten_dp">

    <!-- MAIN CARD -->
    <LinearLayout
        android:id="@+id/cv_relationships_details"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/eight_dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/eight_dp">

            <!-- THREE-DOT ICON -->
            <ImageView
                android:id="@+id/custom_spinner_cardview"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="2dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Actions"
                android:padding="2dp"
                android:src="@drawable/img_17" />

            <!-- Hidden compat view -->
            <ImageView
                android:id="@+id/iv_initiated"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- MATTER TITLE -->
            <include
                android:id="@+id/tv_matter_title"
                layout="@layout/title_name_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/four_dp"
                android:layout_marginEnd="@dimen/four_dp"
                android:layout_toStartOf="@id/custom_spinner_cardview" />

            <!-- CASE NUMBER -->
            <TextView
                android:id="@+id/tv_case_number"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_matter_title"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/eight_dp"
                android:layout_toStartOf="@id/custom_spinner_cardview"
                android:autoSizeMaxTextSize="@dimen/Fifteen_dp"
                android:autoSizeMinTextSize="@dimen/Twelve_dp"
                android:autoSizeTextType="uniform"
                android:ellipsize="end"
                android:fontFamily="@font/gill_sans"
                android:gravity="start"
                android:maxLines="2"
                android:text="@string/case_number"
                android:textColor="@color/Blue_text_color"
                android:textSize="@dimen/Fifteen_dp" />

            <!-- DETAILS ROWS WITH CONSTRAINTLAYOUT -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/cl_details"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/tv_case_number"
                android:layout_alignParentStart="true"
                android:paddingStart="@dimen/four_dp"
                android:paddingEnd="@dimen/four_dp">

                <!-- Content Container -->
                <LinearLayout
                    android:id="@+id/ll_content"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintEnd_toStartOf="@+id/tv_initiated"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent">

                    <!-- Filed date row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten_dp"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/filed"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/tv_date_of_filling"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Client row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <include
                                android:id="@+id/textView"
                                layout="@layout/owner_layout"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content" />

                            <include
                                android:id="@+id/tv_client_name"
                                layout="@layout/owner_layout"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Owner row -->
                    <LinearLayout
                        android:id="@+id/ll_owner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="visible">

                        <include
                            android:id="@+id/owner"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/tv_owner_name"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Tag row -->
                    <LinearLayout
                        android:id="@+id/taglayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/one_dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/tag"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/tv_tag_name"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <!-- Matter Type row -->
                    <LinearLayout
                        android:id="@+id/typeLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/one_dp"
                        android:layout_marginBottom="@dimen/eight_dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <include
                            android:id="@+id/matter_type"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <include
                            android:id="@+id/tv_matter_type"
                            layout="@layout/owner_layout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <!-- STATUS CHIP - positioned at bottom-end of the card -->
                <TextView
                    android:id="@+id/tv_initiated"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/four_dp"
                    android:background="@drawable/chip_active"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:paddingStart="@dimen/ten_dp"
                    android:paddingTop="@dimen/four_dp"
                    android:paddingEnd="@dimen/ten_dp"
                    android:paddingBottom="@dimen/four_dp"
                    android:text="@string/active"
                    android:textColor="@color/white"
                    android:textSize="@dimen/Twelve_dp"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </RelativeLayout>
    </LinearLayout>

    <!-- ACTION LIST CARD -->
    <androidx.cardview.widget.CardView
        android:id="@+id/action_list_card"
        android:layout_width="@dimen/action_list_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="36dp"
        android:layout_marginEnd="@dimen/ten_dp"
        android:elevation="@dimen/ten_dp"
        android:visibility="gone"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/eight_dp"
        app:cardElevation="@dimen/ten_dp">

        <ListView
            android:id="@+id/list_client"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:divider="@android:color/darker_gray"
            android:dividerHeight="0.5dp"
            android:scrollbars="none" />

    </androidx.cardview.widget.CardView>

    <!-- EXPANDABLE SECTION -->
    <LinearLayout
        android:id="@+id/ll_expandable_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginTop="150dp"
        android:orientation="vertical"
        android:visibility="gone">

        <RadioGroup
            android:id="@+id/profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten_dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rb_profile"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_left_green_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:text="@string/profile"
                android:textSize="@dimen/ten_dp" />

            <RadioButton
                android:id="@+id/rb_share_button"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/radiobutton_centre_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:text="@string/share_document"
                android:textSize="@dimen/ten_dp" />

            <RadioButton
                android:id="@+id/rb_share_matter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/radiobutton_centre_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:text="@string/share_matter"
                android:textSize="@dimen/ten_dp" />

            <RadioButton
                android:id="@+id/tv_add_entity"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/button_right_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:singleLine="true"
                android:text="@string/chat"
                android:textSize="@dimen/ten_dp" />
        </RadioGroup>

        <androidx.cardview.widget.CardView
            android:id="@+id/cv_profile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/four_dp"
            android:elevation="@dimen/forty_dp"
            android:visibility="gone"
            app:cardCornerRadius="@dimen/eight_dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/ten_dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/first_name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_first_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/four_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/email_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_email"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/four_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/country_"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_country"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/four_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/contact_name"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_contact_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/four_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/mobile"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_mobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/four_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/website"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_website"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/four_dp"
                    android:fontFamily="@font/gill_sans"
                    android:text="@string/billing_currency"
                    android:textColor="@color/black"
                    android:textSize="@dimen/Fifteen_dp" />

                <TextView
                    android:id="@+id/tv_billing_currency"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/gill_sans"
                    android:textColor="@color/Blue_text_color"
                    android:textSize="@dimen/Fifteen_dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center">

            <RadioGroup
                android:id="@+id/shared_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/Fifteen_dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:visibility="gone">

                <RadioButton
                    android:id="@+id/rb_shared_with_us"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_left_green_background"
                    android:button="@android:color/transparent"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:padding="@dimen/ten_dp"
                    android:singleLine="true"
                    android:text="@string/shared_with_us"
                    android:textSize="@dimen/Fifteen_dp" />

                <RadioButton
                    android:id="@+id/rb_shared_by_us"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/button_right_background"
                    android:button="@android:color/transparent"
                    android:fontFamily="@font/gill_sans"
                    android:gravity="center"
                    android:padding="@dimen/ten_dp"
                    android:singleLine="true"
                    android:text="@string/shared_by_us"
                    android:textSize="@dimen/Fifteen_dp" />
            </RadioGroup>
        </RelativeLayout>

        <RadioGroup
            android:id="@+id/shared_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/thirty_dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rb_already_shared"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_left_green_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:singleLine="true"
                android:text="@string/already_shared"
                android:textSize="@dimen/Fifteen_dp" />

            <RadioButton
                android:id="@+id/rb_choose_to_share"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_right_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:singleLine="true"
                android:text="@string/choose_to_share"
                android:textSize="@dimen/Fifteen_dp" />
        </RadioGroup>

        <RadioGroup
            android:id="@+id/document_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/thirty_dp"
            android:layout_marginTop="32dp"
            android:gravity="center"
            android:orientation="horizontal"
            android:visibility="gone">

            <RadioButton
                android:id="@+id/rb_client_document"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_left_green_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:singleLine="true"
                android:text="@string/client_document"
                android:textSize="@dimen/Fifteen_dp" />

            <RadioButton
                android:id="@+id/rb_firm_document"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/button_right_background"
                android:button="@android:color/transparent"
                android:fontFamily="@font/gill_sans"
                android:gravity="center"
                android:padding="@dimen/ten_dp"
                android:singleLine="true"
                android:text="@string/firm_document"
                android:textSize="@dimen/Fifteen_dp" />
        </RadioGroup>

        <LinearLayout
            android:id="@+id/nestedScrollView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone">

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/search_tm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ten_dp"
                android:hint="@string/search_documents"
                android:textColorHint="@color/black"
                app:boxBackgroundMode="none">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/et_search_documents"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rectangle_grey_background"
                    android:drawableEnd="@drawable/search_groups"
                    android:gravity="start" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:id="@id/ll_documents"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/four_dp"
                    android:elevation="@dimen/forty_dp"
                    app:cardCornerRadius="@dimen/eight_dp">

                    <ScrollView
                        android:layout_width="match_parent"
                        android:layout_height="400dp">

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rv_shared_documents"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:padding="@dimen/ten_dp"
                            android:scrollbars="vertical"
                            app:layoutManager="androidx.recyclerview.widget.LinearLayoutManager" />
                    </ScrollView>
                </androidx.cardview.widget.CardView>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>