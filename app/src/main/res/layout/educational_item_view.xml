<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/edu_bg"
    android:elevation="@dimen/four_dp"
    android:orientation="horizontal"
    android:padding="@dimen/four_dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_weight="3"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <include
                android:id="@+id/et_title"
                layout="@layout/title_des_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/forty_dp"
                android:layout_margin="@dimen/two_dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/et_year"
                layout="@layout/title_des_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/forty_dp"
                android:layout_margin="@dimen/two_dp"
                android:layout_weight="2" />
        </LinearLayout>

        <include
            android:id="@+id/et_content"
            layout="@layout/title_des_layout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/forty_dp"
            android:layout_margin="@dimen/two_dp"
            android:layout_weight="1" />
    </LinearLayout>

    <include
        android:id="@+id/iv_delete"
        layout="@layout/simple_cancel_icon"
        android:layout_width="@dimen/twenty_five"
        android:layout_height="@dimen/twenty_five"
        android:layout_gravity="center" />

</LinearLayout>