<!-- res/layout/custom_layout.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/four_dp"
    android:layout_marginEnd="@dimen/four_dp"
    android:background="@drawable/rectangle_light_grey"
    android:orientation="horizontal">

    <TextView
        android:id="@+id/tv_spinner_view"
        android:layout_width="@dimen/zero_dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_weight="1"
        android:elevation="@dimen/four_dp"
        android:ellipsize="end"
        android:fontFamily="@font/gill_sans"
        android:gravity="center_vertical"
        android:maxLines="1"
        android:padding="@dimen/ten_dp"
        android:textColorHint="@color/grey_color_dark"
        android:textColor="@color/black"
        android:textSize="@dimen/Fifteen_dp" />

    <ImageView
        android:id="@+id/img_dropdown_icon"
        android:layout_width="@dimen/twenty_dp"
        android:layout_height="@dimen/twenty_dp"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="@dimen/Fifteen_dp"
        android:contentDescription="@string/image_1"
        android:src="@drawable/drop_down_blue"
        android:visibility="visible" />

    <ImageView
        android:id="@+id/img_clear_icon"
        android:layout_width="@dimen/thirty_dp"
        android:layout_height="@dimen/thirty_dp"
        android:layout_gravity="center_vertical"
        android:layout_marginStart="@dimen/four_dp"
        android:layout_marginEnd="@dimen/eight_dp"
        android:contentDescription="@string/image_2"
        android:src="@drawable/simple_cancel_blue"
        android:visibility="gone" />
</LinearLayout>
