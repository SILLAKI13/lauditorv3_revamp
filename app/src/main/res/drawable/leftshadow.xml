<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Background gradient -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:endColor="@color/material_dynamic_neutral_variant0"
                android:startColor="@color/dark_brown"
                android:angle="90"/>
        </shape>
    </item>
    <!-- Shadow-like effect on the right side -->
    <item android:left="@dimen/one_dp">
        <shape android:shape="rectangle">
            <solid android:color="#00B3A7" />
        </shape>
    </item>
</layer-list>